#!/usr/bin/env python3
"""Prepare and probe CORE-V Wally as the L2.5 lightweight RV64 integration base."""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path


DEFAULT_REPO = "https://github.com/openhwgroup/cvw.git"
DEFAULT_COMMIT = "03f16461df99ac6de077a0549693c887fa04892d"
STATUS_ENUM = (
    "pass",
    "fail",
    "timeout",
    "unsupported",
    "blocked_missing_artifact",
    "blocked_env",
)
MATRIX_STATUSES = (
    "direct_run",
    "needs_wally_harness_support",
    "needs_test_adaptation",
    "target_unsupported",
    "blocked_env",
)


def repo_root() -> Path:
    return Path(__file__).resolve().parents[2]


def run(command: list[str], cwd: Path, log_path: Path, timeout: int = 600, env: dict[str, str] | None = None) -> tuple[str, int | None, float]:
    log_path.parent.mkdir(parents=True, exist_ok=True)
    start = time.monotonic()
    with log_path.open("w", encoding="utf-8") as log:
        log.write("$ " + " ".join(command) + "\n\n")
        try:
            completed = subprocess.run(command, cwd=cwd, env=env, stdout=log, stderr=subprocess.STDOUT, timeout=timeout, check=False)
            return ("pass" if completed.returncode == 0 else "fail"), completed.returncode, round(time.monotonic() - start, 3)
        except subprocess.TimeoutExpired:
            log.write(f"\nTIMEOUT after {timeout}s\n")
            return "timeout", None, round(time.monotonic() - start, 3)


def candidate_riscv_prefixes() -> list[Path]:
    prefixes = []
    env_riscv = os.environ.get("RISCV")
    if env_riscv:
        prefixes.append(Path(env_riscv))
    prefixes.extend(
        [
            Path("/usr"),
            Path("/usr/local"),
            Path.home() / "riscv-unknown-elf",
            Path.home() / "riscv",
        ]
    )
    unique = []
    seen = set()
    for prefix in prefixes:
        key = str(prefix)
        if key not in seen:
            seen.add(key)
            unique.append(prefix)
    return unique


def infer_riscv_prefix() -> Path | None:
    for prefix in candidate_riscv_prefixes():
        if (prefix / "bin" / "riscv64-unknown-elf-gcc").exists():
            return prefix
    path_gcc = shutil.which("riscv64-unknown-elf-gcc")
    if path_gcc:
        return Path(path_gcc).resolve().parents[1]
    return None


def toolchain_env(base: dict[str, str] | None = None) -> dict[str, str]:
    env = (base or os.environ).copy()
    prefix = Path(env["RISCV"]) if env.get("RISCV") else infer_riscv_prefix()
    extra_paths = []
    if prefix is not None:
        env["RISCV"] = str(prefix)
        extra_paths.append(str(prefix / "bin"))
    for candidate in (
        Path.home() / "spike-local" / "install" / "bin",
        Path.home() / "spike-local" / "build",
    ):
        if (candidate / "elf2hex").exists():
            extra_paths.append(str(candidate))
    if extra_paths:
        env["PATH"] = ":".join(extra_paths + [env.get("PATH", "")])
    return env


def prepend_existing_paths(env: dict[str, str], paths: list[Path]) -> dict[str, str]:
    existing = [str(path) for path in paths if path.is_dir()]
    if existing:
        env["PATH"] = ":".join(existing + [env.get("PATH", "")])
    return env


def wally_manifest_env(cvw: Path) -> dict[str, str]:
    env = toolchain_env()
    env["WALLY"] = str(cvw)
    prepend_existing_paths(env, [Path("/home/linuxbrew/.linuxbrew/bin")])
    cvw_bin = cvw / "bin"
    if cvw_bin.is_dir():
        env["PATH"] = ":".join([env.get("PATH", ""), str(cvw_bin)])
    return env


def toolchain_diagnostics(env: dict[str, str] | None = None) -> dict:
    check_env = toolchain_env(env)
    path = check_env.get("PATH", "")
    riscv = check_env.get("RISCV")
    prefix_gcc = str(Path(riscv) / "bin" / "riscv64-unknown-elf-gcc") if riscv else None
    prefix_gcc_exists = bool(prefix_gcc and Path(prefix_gcc).exists())
    elf2hex_candidates = [
        str(path)
        for path in (
            Path.home() / "spike-local" / "install" / "bin" / "elf2hex",
            Path.home() / "spike-local" / "build" / "elf2hex",
        )
        if path.exists()
    ]
    return {
        "env_RISCV": os.environ.get("RISCV"),
        "effective_RISCV": riscv,
        "prefix_gcc": prefix_gcc,
        "prefix_gcc_exists": prefix_gcc_exists,
        "tools": {
            name: shutil.which(name, path=path)
            for name in (
                "riscv64-unknown-elf-gcc",
                "riscv64-unknown-elf-objcopy",
                "riscv64-unknown-elf-objdump",
                "riscv64-linux-gnu-gcc",
                "elf2hex",
            )
        },
        "elf2hex_candidates": elf2hex_candidates,
    }


def prepare(root: Path, output_dir: Path, repo: str, commit: str) -> dict:
    cvw = root / "build" / "external" / "cvw"
    log_dir = output_dir / "logs"
    result = {
        "repo": repo,
        "requested_commit": commit,
        "checkout": str(cvw),
        "status": "pass",
        "reason": "prepared",
        "commands": [],
    }
    if shutil.which("git") is None:
        result.update({"status": "blocked_env", "reason": "git not found"})
        return result
    if not cvw.exists():
        status, rc, elapsed = run(["git", "clone", "--depth", "1", repo, str(cvw)], root, log_dir / "clone.log", timeout=1800)
        result["commands"].append({"name": "clone", "status": status, "return_code": rc, "host_time": elapsed, "log_path": str(log_dir / "clone.log")})
        if status != "pass":
            result.update({"status": "blocked_env", "reason": "git clone failed"})
            return result
    for lock_name in ("shallow.lock", "index.lock"):
        lock = cvw / ".git" / lock_name
        if lock.exists():
            lock.unlink()
    safe_git = ["git", "-c", f"safe.directory={cvw}"]
    status, rc, elapsed = run([*safe_git, "fetch", "--depth", "1", "origin", commit], cvw, log_dir / "fetch.log", timeout=600)
    result["commands"].append({"name": "fetch", "status": status, "return_code": rc, "host_time": elapsed, "log_path": str(log_dir / "fetch.log")})
    if status == "pass":
        status, rc, elapsed = run([*safe_git, "checkout", "--detach", commit], cvw, log_dir / "checkout.log", timeout=120)
        result["commands"].append({"name": "checkout", "status": status, "return_code": rc, "host_time": elapsed, "log_path": str(log_dir / "checkout.log")})
    if status != "pass":
        result.update({"status": "blocked_env", "reason": "git checkout failed"})
        return result
    completed = subprocess.run([*safe_git, "rev-parse", "HEAD"], cwd=cvw, text=True, capture_output=True, check=False)
    result["actual_commit"] = completed.stdout.strip() if completed.returncode == 0 else ""
    result["tools"] = {name: shutil.which(name) for name in ("make", "verilator", "python3", "riscv64-unknown-elf-gcc", "riscv64-linux-gnu-gcc")}
    result["toolchain"] = toolchain_diagnostics()
    return result


def load_manifest(path: Path) -> dict:
    return json.loads(path.read_text(encoding="utf-8"))


def classify_test(test: dict) -> tuple[str, str]:
    suite = test["suite"]
    needs = set(test.get("needs", []))
    if suite in {"rv64ui", "rv64um"}:
        return "needs_wally_harness_support", "需要把本轮 ELF/bin 和 a0+ebreak pass/fail 协议接入 Wally testbench/runner"
    if suite == "rv64mi":
        if "pmp" in needs or "breakpoint" in needs or "counter" in needs:
            return "needs_test_adaptation", "特权 CSR/PMP/debug/counter 行为需要先确认 Wally testbench 暴露和结束协议"
        if "exception" in needs or "misaligned" in needs or "ecall" in needs:
            return "needs_wally_harness_support", "需要 trap/exception/redirect 事件与 pass/fail 结束协议支持"
        return "needs_wally_harness_support", "需要 M-mode CSR/trap harness 支持"
    return "target_unsupported", f"未纳入本轮 Wally 评估 suite: {suite}"


def support_matrix(root: Path, output_dir: Path, manifest_path: Path, prepare_result: dict) -> dict:
    manifest = load_manifest(manifest_path)
    rows = []
    by_status = {status: 0 for status in MATRIX_STATUSES}
    if prepare_result["status"] != "pass":
        for test in manifest.get("tests", []):
            rows.append({"id": test["id"], "suite": test["suite"], "status": "blocked_env", "reason": prepare_result["reason"], "needs": test.get("needs", [])})
            by_status["blocked_env"] += 1
    else:
        for test in manifest.get("tests", []):
            status, reason = classify_test(test)
            rows.append({"id": test["id"], "suite": test["suite"], "status": status, "reason": reason, "needs": test.get("needs", []), "artifacts": test.get("artifacts", {})})
            by_status[status] += 1
    return {
        "schema_version": 1,
        "target": "wally-isa-matrix",
        "manifest": str(manifest_path),
        "summary": {"total": len(rows), "by_status": by_status},
        "tests": rows,
    }


def artifact_path(root: Path, raw: str) -> Path:
    path = Path(raw)
    if path.exists():
        return path
    marker = "baremetal/"
    if marker in raw:
        return root / marker.rstrip("/") / raw.split(marker, 1)[1]
    return path


def manifest_test_by_id(manifest: dict, test_id: str) -> dict | None:
    for test in manifest.get("tests", []):
        if test.get("id") == test_id or f"{test.get('suite')}/{test.get('name')}" == test_id:
            return test
    return None


def ensure_manifest_submodules(cvw: Path, output_dir: Path, env: dict[str, str]) -> list[dict]:
    commands = []
    verilog_ethernet = cvw / "addins" / "verilog-ethernet"
    has_sources = any(verilog_ethernet.glob("*/*.sv")) or any(verilog_ethernet.glob("*/*/*/*.sv"))
    if not has_sources:
        log = output_dir / "logs" / "manifest-verilog-ethernet-submodule.log"
        safe_git = ["git", "-c", f"safe.directory={cvw}"]
        status, rc, elapsed = run(
            [*safe_git, "submodule", "update", "--init", "--depth", "1", "addins/verilog-ethernet"],
            cvw,
            log,
            timeout=600,
            env=env,
        )
        commands.append({"name": "verilog-ethernet-submodule", "command": [*safe_git, "submodule", "update", "--init", "--depth", "1", "addins/verilog-ethernet"], "status": status, "return_code": rc, "host_time": elapsed, "log_path": str(log)})
    return commands


def classify_manifest_attempt_log(log_path: Path, run_status: str, return_code: int | None) -> tuple[str, str]:
    text = log_path.read_text(encoding="utf-8", errors="replace") if log_path.exists() else ""
    if run_status == "timeout":
        return "timeout", "Wally manifest ELF attempt timed out"
    if "SUCCESS! All tests ran without failures." in text:
        return "direct_run", "Wally wsim completed and reported all tests passed"
    if "Single Elf file tests are not signatured verified." in text:
        return "direct_run", "Wally wsim executed the external ELF; single-ELF mode has no signature verification"
    if "Cannot find file containing module" in text and "addins/verilog-ethernet" in text:
        return "needs_wally_harness_support", "Wally Verilator compile requires addins/verilog-ethernet submodule before external ELF can run"
    if "%Error: Exiting due to" in text and "warning(s)" in text:
        return "needs_wally_harness_support", "Wally Verilator compile fails because current Verilator treats Wally warnings as fatal; sim/verilator/Makefile needs a compatible warning policy or Verilator version"
    if "Error: Could not open file" in text or ".memfile" in text and "No such file" in text:
        return "needs_wally_harness_support", "external ELF path requires .memfile/.objdump.addr/.objdump.lab sidecars generated through Wally testbench/Makefile"
    if return_code not in (0, None):
        return "fail", "Wally manifest ELF attempt returned non-zero"
    return "needs_wally_harness_support", "Wally wsim did not emit a recognized pass marker for the external ELF attempt"


def manifest_attempt(root: Path, output_dir: Path, manifest_path: Path, prepare_result: dict, test_id: str, timeout: int) -> dict:
    cvw = root / "build" / "external" / "cvw"
    manifest = load_manifest(manifest_path)
    test = manifest_test_by_id(manifest, test_id)
    seams = [
        {"file": "bin/wsim", "evidence": "accepts a testsuite path ending in .elf or --elf and passes +ElfFile to the simulator"},
        {"file": "testbench/testbench.sv", "evidence": "external ElfFile mode loads ElfFile.memfile plus ElfFile.objdump.addr/lab, and explicitly says single ELF tests are not signature verified"},
        {"file": "testbench/Makefile", "evidence": "generates .memfile, .objdump.addr and .objdump.lab from an ELF"},
        {"file": "sim/verilator/Makefile", "evidence": "compiles the Verilator testbench and pulls addins/verilog-ethernet sources; warning policy is currently not externally parameterized by wsim"},
    ]
    if prepare_result["status"] != "pass":
        return {"status": "blocked_env", "reason": prepare_result["reason"], "test_id": test_id, "seams": seams}
    if test is None:
        return {"status": "blocked_missing_artifact", "reason": f"manifest test not found: {test_id}", "test_id": test_id, "seams": seams}
    raw_elf = test.get("artifacts_by_backend", {}).get("xiangshan", {}).get("elf") or test.get("artifacts", {}).get("elf")
    if not raw_elf:
        return {"status": "blocked_missing_artifact", "reason": "manifest entry lacks a XiangShan/default ELF artifact", "test_id": test_id, "test": test, "seams": seams}
    elf = artifact_path(root, raw_elf)
    if not elf.exists():
        return {"status": "blocked_missing_artifact", "reason": "manifest ELF artifact is missing", "test_id": test_id, "elf": str(elf), "test": test, "seams": seams}
    env = wally_manifest_env(cvw)
    prep_commands = ensure_manifest_submodules(cvw, output_dir, env)
    log_path = output_dir / "logs" / f"manifest-attempt-{test['id']}.log"
    command = [
        sys.executable,
        str(cvw / "bin" / "wsim"),
        "rv64gc",
        str(elf),
        "--sim",
        "verilator",
        "--args",
        "+INSTR_LIMIT=200000",
    ]
    run_status, rc, elapsed = run(command, root, log_path, timeout=timeout, env=env)
    status, reason = classify_manifest_attempt_log(log_path, run_status, rc)
    return {
        "schema_version": 1,
        "target": "wally-manifest-single-elf",
        "status": status,
        "reason": reason,
        "test_id": test["id"],
        "suite": test["suite"],
        "name": test["name"],
        "elf": str(elf),
        "sidecars": {
            "memfile": str(elf) + ".memfile",
            "objdump_addr": str(elf) + ".objdump.addr",
            "objdump_lab": str(elf) + ".objdump.lab",
        },
        "command": command,
        "return_code": rc,
        "runner_status": run_status,
        "host_time": elapsed,
        "log_path": str(log_path),
        "prepare_commands": prep_commands,
        "toolchain": toolchain_diagnostics(env),
        "runtime_tools": {
            tool: shutil.which(tool, path=env.get("PATH", ""))
            for tool in ("python3", "make", "verilator", "elf2hex", "extractFunctionRadix.sh", "uv")
        },
        "seams": seams,
    }


def scan_seam(root: Path) -> dict:
    cvw = root / "build" / "external" / "cvw"
    evidence = []
    if cvw.is_dir():
        for path in sorted((cvw / "src").rglob("*")) if (cvw / "src").is_dir() else []:
            if path.is_file() and path.suffix.lower() in {".sv", ".v", ".vh"}:
                text = path.read_text(encoding="utf-8", errors="ignore")
                lowered = text.lower()
                if any(token in lowered for token in ("branch", "predict", "flush", "redirect", "commit", "exception")):
                    evidence.append(str(path.relative_to(cvw)))
                if len(evidence) >= 40:
                    break
    verdict = "needs_wally_harness_support" if evidence else "blocked_env"
    reason = "找到前端/异常/提交相关源码路径，但仍需 testbench seam 才能接入外部 XiangShan BPU wrapper" if evidence else "未能扫描 Wally src 路径"
    return {"status": verdict, "reason": reason, "evidence_paths": evidence}


def benchmark_attempt(root: Path, output_dir: Path, benchmark: str, prepare_result: dict) -> dict:
    cvw = root / "build" / "external" / "cvw"
    matches = []
    if cvw.is_dir():
        for path in cvw.rglob("*"):
            name = path.name.lower()
            if benchmark.lower() in name:
                matches.append(str(path.relative_to(cvw)))
                if len(matches) >= 20:
                    break
    status = "needs_wally_harness_support" if prepare_result["status"] == "pass" else "blocked_env"
    reason = "发现 benchmark 相关路径，但本轮尚未找到可直接消费本仓 baremetal workload 的 Wally runner" if matches else "未找到可直接运行的 benchmark target"
    command_result = None
    diag = toolchain_diagnostics()
    if prepare_result["status"] != "pass":
        reason = prepare_result["reason"]
    elif benchmark == "coremark" and (cvw / "benchmarks" / "coremark" / "Makefile").exists():
        env = toolchain_env()
        env["WALLY"] = str(cvw)
        env["PATH"] = f"{cvw / 'bin'}:{env.get('PATH', '')}"
        diag = toolchain_diagnostics(env)
        submodule_result = None
        if not (cvw / "addins" / "coremark" / "core_main.c").exists():
            sub_log = output_dir / "logs" / "coremark-submodule.log"
            safe_git = ["git", "-c", f"safe.directory={cvw}"]
            sub_status, sub_rc, sub_elapsed = run(
                [*safe_git, "submodule", "update", "--init", "--depth", "1", "addins/coremark"],
                cvw,
                sub_log,
                timeout=600,
                env=env,
            )
            submodule_result = {"command": [*safe_git, "submodule", "update", "--init", "--depth", "1", "addins/coremark"], "status": sub_status, "return_code": sub_rc, "host_time": sub_elapsed, "log_path": str(sub_log)}
        log_path = output_dir / "logs" / "coremark-run.log"
        cmd = ["make", "-C", str(cvw / "benchmarks" / "coremark"), "run", "XLEN=64"]
        run_status, rc, elapsed = run(cmd, cvw, log_path, timeout=300, env=env)
        command_result = {"command": cmd, "status": run_status, "return_code": rc, "host_time": elapsed, "log_path": str(log_path), "submodule": submodule_result}
        if run_status == "pass":
            status = "direct_run"
            reason = "Wally CoreMark run target completed"
        else:
            text = log_path.read_text(encoding="utf-8", errors="replace") if log_path.exists() else ""
            if any(token in text for token in ("riscv64-unknown-elf-gcc", "elf2hex", "not found", "No such file")):
                status = "blocked_env"
                reason = "Wally CoreMark run target exists, but required baremetal toolchain/helper is missing"
            else:
                status = "needs_wally_harness_support"
                reason = "Wally CoreMark run target was attempted but did not complete under current harness"
    return {
        "schema_version": 1,
        "target": "wally-benchmark",
        "benchmark": benchmark,
        "status": status,
        "reason": reason,
        "toolchain": diag,
        "evidence_paths": matches,
        "attempt": command_result,
    }


def aggregate_benchmark_status(benchmark_status: str, prepare_status: str) -> str:
    if prepare_status != "pass":
        return prepare_status if prepare_status in STATUS_ENUM else "blocked_env"
    if benchmark_status == "direct_run":
        return "pass"
    if benchmark_status == "needs_wally_harness_support":
        return "unsupported"
    if benchmark_status in STATUS_ENUM:
        return benchmark_status
    if benchmark_status in {"target_unsupported", "needs_test_adaptation"}:
        return "unsupported"
    return "fail"


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--prepare", action="store_true")
    parser.add_argument("--manifest", type=Path)
    parser.add_argument("--benchmark", choices=("coremark", "dhrystone"))
    parser.add_argument("--output", type=Path, default=None)
    parser.add_argument("--repo-root", type=Path, default=repo_root())
    parser.add_argument("--repo", default=os.environ.get("VALIDATION_WALLY_REPO", DEFAULT_REPO))
    parser.add_argument("--commit", default=os.environ.get("VALIDATION_WALLY_COMMIT", DEFAULT_COMMIT))
    parser.add_argument("--attempt-test", default=os.environ.get("VALIDATION_WALLY_ATTEMPT_TEST", "rv64ui-p-add"))
    parser.add_argument("--attempt-timeout", type=int, default=int(os.environ.get("VALIDATION_WALLY_ATTEMPT_TIMEOUT", "600")))
    args = parser.parse_args(argv)

    root = args.repo_root.resolve()
    output = args.output or (root / "build" / "validation" / "wally" / "results.json")
    output_dir = output.parent
    prep = prepare(root, output_dir, args.repo, args.commit)
    payload = {"schema_version": 1, "layer": "l25", "prepare": prep, "status": prep["status"]}
    if args.manifest:
        matrix = support_matrix(root, output_dir, args.manifest, prep)
        payload["matrix"] = matrix
        payload["seam"] = scan_seam(root)
        payload["manifest_attempt"] = manifest_attempt(root, output_dir, args.manifest, prep, args.attempt_test, args.attempt_timeout)
        payload["status"] = "pass" if prep["status"] == "pass" and matrix["summary"]["total"] > 0 else prep["status"]
    if args.benchmark:
        payload["benchmark"] = benchmark_attempt(root, output_dir, args.benchmark, prep)
        payload["seam"] = scan_seam(root)
        payload["toolchain"] = payload["benchmark"].get("toolchain", toolchain_diagnostics())
        payload["status"] = aggregate_benchmark_status(payload["benchmark"]["status"], prep["status"])
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    print(json.dumps(payload, indent=2, sort_keys=True))
    print(f"VALIDATION_STATUS={payload['status']}")
    print("VALIDATION_REASON=wally feasibility probe")
    return 0 if payload["status"] == "pass" else 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
