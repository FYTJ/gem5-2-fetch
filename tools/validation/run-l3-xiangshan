STATUS_ENUM = ("pass", "fail", "timeout", "oom", "unsupported", "blocked_missing_artifact", "blocked_env")
SPEC2006_DEFAULT_CHECKPOINT_END_MAXINSTS = 40 * 10**6
ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")
ABORT_PC_RE = re.compile(r"ABORT at pc = 0x([0-9a-fA-F]+)")
CORE_STATS_RE = re.compile(
    r"Core-(?P<core>\d+)\s+instrCnt = (?P<instr>[\d,']+), cycleCnt = (?P<cycle>[\d,']+), IPC = (?P<ipc>[0-9.]+)"
)
GUEST_CYCLE_RE = re.compile(r"Guest cycle spent: (?P<cycles>[\d,']+)")
HOST_TIME_RE = re.compile(r"Host time spent: (?P<ms>[\d,']+)ms")


def parse_counter(raw: str | None) -> int | None:
    if raw is None:
        return None
    try:
        return int(raw.replace(",", "").replace("'", ""))
    except ValueError:
        return None


def line_buffered_command(command: list[str]) -> list[str]:
    stdbuf = shutil.which("stdbuf")
    if not stdbuf:
        return command
    return [stdbuf, "-oL", "-eL", *command]


def repo_root() -> Path:
    return Path(__file__).resolve().parents[2]


def load_manifest(path: Path) -> dict:
    return json.loads(path.read_text(encoding="utf-8"))


def iso_now() -> str:
    return datetime.now(timezone.utc).isoformat()


def resolve_repo_path(root: Path, path: Path | None) -> Path | None:
    if path is None:
        return None
    if path.is_absolute():
        return path
    return root / path


def xiangshan_subprocess_env(root: Path) -> dict[str, str]:
    env = os.environ.copy()
    xs_home = root / "XiangShan"
    ready_to_run = xs_home / "ready-to-run"
    env.setdefault("NOOP_HOME", str(xs_home))
    env.setdefault("NEMU_HOME", str(ready_to_run))
    env.setdefault("AM_HOME", str(ready_to_run))
    return env


def test_matches(test: dict, filters: set[str]) -> bool:
    if not filters:
        return True
    names = {
        test.get("id", ""),
        test.get("name", ""),
        f"{test.get('suite', '')}/{test.get('name', '')}",
        f"{test.get('suite', '')}-p-{test.get('name', '')}",
    }
    return bool(names & filters)


def select_manifest_tests(manifest: dict, filters: set[str], suite: str | None, suite_source: Path, manifest_path: Path) -> list[dict]:
    tests = manifest.get("tests", [])
    suite_ids: set[str] | None = None
    if suite == SUPPORTED_SUITE_ID:
        suite_payload = build_supported_suite(suite_source, manifest_path)
        suite_ids = set(suite_payload["ids"])
    selected = []
    for test in tests:
        if suite_ids is not None and test.get("id") not in suite_ids:
            continue
        if not test_matches(test, filters):
            continue
        selected.append(test)
    return selected


def artifact_for_backend(root: Path, test: dict, backend: str) -> Path:
    by_backend = test.get("artifacts_by_backend", {})
    raw = by_backend.get(backend, {}).get("bin", "")
    if not raw and backend == "xiangshan":
        raw = test.get("artifacts", {}).get("bin", "")
    path = Path(raw)
    if path.exists():
        return path
    marker = "baremetal/"
    if marker in raw:
        return root / marker.rstrip("/") / raw.split(marker, 1)[1]
    return path


def xiangshan_log_summary(log_path: Path) -> dict:
    text = log_path.read_text(encoding="utf-8", errors="replace") if log_path.exists() else ""
    plain_text = ANSI_RE.sub("", text)
    summary: dict[str, object] = {
        "abort_pc": None,
        "instrCnt": None,
        "cycleCnt": None,
        "IPC": None,
        "guest_cycle_spent": None,
        "host_time_spent_ms": None,
        "critical_error_marker": None,
        "commit_stuck_marker": None,
        "limit_marker": None,
    }
    for line in plain_text.splitlines():
        lowered = line.lower()
        if summary["critical_error_marker"] is None and "critical_error diff ref" in lowered:
            summary["critical_error_marker"] = line.strip()
        if summary["commit_stuck_marker"] is None and "no instruction of core" in lowered and "commits for" in lowered:
            summary["commit_stuck_marker"] = line.strip()
        if summary["limit_marker"] is None and "exceeding cycle/instr limit" in lowered:
            summary["limit_marker"] = line.strip()
        if summary["abort_pc"] is None:
            match = ABORT_PC_RE.search(line)
            if match:
                summary["abort_pc"] = f"0x{match.group(1).lower()}"
        stats = CORE_STATS_RE.search(line)
        if stats:
            summary["instrCnt"] = parse_counter(stats.group("instr"))
            summary["cycleCnt"] = parse_counter(stats.group("cycle"))
            summary["IPC"] = float(stats.group("ipc"))
        guest = GUEST_CYCLE_RE.search(line)
        if guest:
            summary["guest_cycle_spent"] = parse_counter(guest.group("cycles"))
        host = HOST_TIME_RE.search(line)
        if host:
            summary["host_time_spent_ms"] = parse_counter(host.group("ms"))
    return summary


def classify_log(log_path: Path, rc: int | None, timed_out: bool) -> tuple[str, str]:
    text = log_path.read_text(encoding="utf-8", errors="replace") if log_path.exists() else ""
    plain_text = ANSI_RE.sub("", text)
    log_summary = xiangshan_log_summary(log_path)
    if "HIT BAD TRAP" in plain_text:
        return "fail", "HIT BAD TRAP"
    if log_summary["critical_error_marker"] is not None:
        return "fail", "xiangshan critical error differs from reference"
    if log_summary["commit_stuck_marker"] is not None:
        return "fail", "xiangshan commit stuck"
    if log_summary["abort_pc"] is not None or "Core 0: ABORT" in plain_text or "Core-0: ABORT" in plain_text:
        return "fail", "xiangshan core abort"
    lowered = plain_text.lower()
    for line in lowered.splitlines():
        if "difftest" in line and any(term in line for term in ("fail", "mismatch", "abort", "panic")):
            return "fail", "difftest failure marker"
    if "HIT GOOD TRAP" in plain_text:
        return "pass", "HIT GOOD TRAP"
    if "EXCEEDING CYCLE/INSTR LIMIT" in plain_text:
        return "unsupported", "max instruction limit reached"
    if timed_out:
        return "timeout", "xiangshan emu timed out"
    if rc != 0:
        return "fail", "xiangshan emu returned non-zero"
    return "unsupported", "no recognized XiangShan pass/fail marker"


def difftest_log_evidence(log_path: Path) -> dict:
    text = log_path.read_text(encoding="utf-8", errors="replace") if log_path.exists() else ""
    enabled_line = None
    mismatch_line = None
    checkpoint_line = None
    for line in text.splitlines():
        lowered = line.lower()
        if enabled_line is None and "difftest" in lowered and any(token in lowered for token in ("enable", "ref", "proxy", "nemu")):
            enabled_line = line.strip()
        if mismatch_line is None and "difftest" in lowered and any(token in lowered for token in ("fail", "mismatch", "abort")):
            mismatch_line = line.strip()
        if checkpoint_line is None and (".zstd" in line or "load" in lowered and "image" in lowered):
            checkpoint_line = line.strip()
    return {
        "enabled_marker": enabled_line,
        "mismatch_marker": mismatch_line,
        "checkpoint_marker": checkpoint_line,
        "enabled": enabled_line is not None,
    }


def summarize(rows: list[dict]) -> dict:
    by_status = {status: 0 for status in STATUS_ENUM}
    by_suite: dict[str, dict[str, int]] = {}
    for row in rows:
        status = row["status"]
        by_status[status] = by_status.get(status, 0) + 1
        suite = row.get("suite", "unknown")
        by_suite.setdefault(suite, {s: 0 for s in STATUS_ENUM})
        by_suite[suite][status] = by_suite[suite].get(status, 0) + 1
    return {"total": len(rows), "by_status": by_status, "by_suite": by_suite}


def select_spec2006_entries(manifest: dict, filters: set[str], canary: bool) -> list[dict]:
    entries = manifest.get("benchmarks", [])
    if canary:
        entries = [entry for entry in entries if entry.get("canary") or entry.get("id") == manifest.get("canary_id")]
    if not filters:
        return list(entries)
    selected = []
    for entry in entries:
        names = {
            str(entry.get("id", "")),
            str(entry.get("benchmark", "")),
            str(entry.get("workload", "")),
            f"{entry.get('benchmark', '')}/{entry.get('workload', '')}",
            f"{entry.get('workload', '')}-{entry.get('point', '')}",
        }
        if names & filters:
            selected.append(entry)
    return selected


def effective_gcpt_layout(entry: dict, detected: dict) -> str:
    detected_layout = str(detected.get("layout") or "unknown")
    if detected_layout != "unknown":
        return detected_layout
    return str(entry.get("gcpt_layout") or "unknown")


def requires_rvh_checkpoint(entry: dict, layout: str) -> bool:
    return layout == "embedded-rvh" or bool(entry.get("requires_rvh"))


def requires_h_aware_ref(entry: dict, layout: str) -> bool:
    return layout == "embedded-rvh" or bool(entry.get("requires_h_aware_ref"))


def checkpoint_integrity_error(entry: dict, checkpoint: Path) -> str | None:
    expected_bytes = entry.get("compressed_bytes")
    if expected_bytes is None:
        return None
    try:
        expected = int(expected_bytes)
    except (TypeError, ValueError):
        return f"invalid checkpoint compressed_bytes metadata: {expected_bytes!r}"
    actual = checkpoint.stat().st_size
    if actual != expected:
        return f"checkpoint compressed size mismatch: expected {expected} bytes, found {actual} bytes"
    return None


def default_difftest_ref_so(root: Path, requires_h_aware: bool = False) -> Path:
    if requires_h_aware and os.environ.get("GCBH_REF_SO"):
        return Path(os.environ["GCBH_REF_SO"])
    return root / "XiangShan" / "ready-to-run" / "riscv64-nemu-interpreter-so"


def resolve_difftest_ref_so(root: Path, requested: Path | None, requires_h_aware: bool = False) -> Path:
    return resolve_repo_path(root, requested) or default_difftest_ref_so(root, requires_h_aware)


def default_gcpt_restorer_candidates(root: Path) -> list[Path]:
    return [
        root / "NEMU" / "resource" / "gcpt_restore" / "build" / "gcpt.bin",
        root / "XiangShan" / "NEMU" / "resource" / "gcpt_restore" / "build" / "gcpt.bin",
    ]


def normalize_gcpt_restorer_path(root: Path, raw: str) -> tuple[Path | None, str | None]:
    path = resolve_repo_path(root, Path(raw))
    if path is None:
        return None, "gcpt restorer path was not resolved"
    if path.is_dir():
        path = path / "build" / "gcpt.bin"
    if not path.exists():
        return path, "missing gcpt restorer"
    return path, None


def resolve_gcpt_restorer(root: Path, entry: dict, requested: str | None, layout: str) -> tuple[Path | None, str, str | None]:
    requested = requested or "auto"
    if layout == "embedded-rvh":
        if requested in {"auto", "none"}:
            return None, "none", None
        return (
            None,
            requested,
            "checkpoint is embedded RVH/new-layout GCPT; use --gcpt-restorer none to avoid overwriting its embedded restorer",
        )
    if requested == "auto":
        manifest_value = entry.get("gcpt_restorer")
        if manifest_value and manifest_value not in {"auto", "unknown", "none"}:
            requested = str(manifest_value)
        else:
            env_value = os.environ.get("GCB_RESTORER")
            if env_value:
                requested = env_value
            else:
                for candidate in default_gcpt_restorer_candidates(root):
                    if candidate.exists():
                        return candidate, "auto", None
                return None, "auto", "missing gcpt restorer; set GCB_RESTORER, pass --gcpt-restorer <path>, or build NEMU/resource/gcpt_restore/build/gcpt.bin"
    if requested == "none":
        return None, "none", None
    path, error = normalize_gcpt_restorer_path(root, requested)
    return path, requested, error


def spec2006_target(run_mode: str, maxcycles: int | None = None) -> str:
    if maxcycles is not None and maxcycles > 0:
        return "xiangshan-spec2006-cycle-debug"
    if run_mode == "complete":
        return "xiangshan-spec2006-full-difftest"
    return "xiangshan-spec2006-checkpoint"


def xiangshan_gcpt_log_evidence(log_path: Path) -> dict:
    text = log_path.read_text(encoding="utf-8", errors="replace") if log_path.exists() else ""
    checkpoint_line = None
    restorer_line = None
    maxinsts_line = None
    for line in text.splitlines():
        lowered = line.lower()
        if checkpoint_line is None and any(token in lowered for token in ("checkpoint", ".zstd", "restore", "load image", "load memory")):
            checkpoint_line = line.strip()
        if restorer_line is None and "restorer" in lowered:
            restorer_line = line.strip()
        if maxinsts_line is None and any(token in lowered for token in ("max instruction", "maxinst", "max instr", "max commit", "simulation reaches", "exceeding cycle/instr limit")):
            maxinsts_line = line.strip()
    return {
        "checkpoint_marker": checkpoint_line,
        "restorer_marker": restorer_line,
        "maxinsts_marker": maxinsts_line,
        "entered_checkpoint": checkpoint_line is not None,
        "reached_maxinsts": maxinsts_line is not None,
    }


def terminate_process_group(process: subprocess.Popen, log) -> bool:
    killed = False
    try:
        os.killpg(process.pid, signal.SIGTERM)
        killed = True
        log.write("\nSent SIGTERM to XiangShan emu process group\n")
    except ProcessLookupError:
        return killed
    try:
        process.wait(timeout=5)
        return killed
    except subprocess.TimeoutExpired:
        try:
            os.killpg(process.pid, signal.SIGKILL)
            killed = True
            log.write("Sent SIGKILL to XiangShan emu process group\n")
        except ProcessLookupError:
            return killed
        process.wait(timeout=5)
        return killed


def write_payload(output: Path, payload: dict) -> None:
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    print(json.dumps(payload, indent=2, sort_keys=True))
    print(f"VALIDATION_STATUS={payload['status']}")
    print(f"VALIDATION_REASON={payload['reason']}")


def blocked_rows(tests: list[dict], reason: str, status: str = "blocked_env") -> list[dict]:
    if not tests:
        return [{"stage": "isa", "status": status, "reason": reason}]
    return [
        {
            "id": test["id"],
            "suite": test["suite"],
            "backend": "xiangshan",
            "status": status,
            "reason": reason,
        }
        for test in tests
    ]


def run_one(root: Path, test: dict, output_dir: Path, timeout: int, emu: Path, ref: Path) -> dict:
    test_id = test["id"]
    bin_path = artifact_for_backend(root, test, "xiangshan")
    if not bin_path.exists():
        return {
            "id": test_id,
            "suite": test["suite"],
            "backend": "xiangshan",
            "status": "blocked_missing_artifact",
            "reason": "missing xiangshan backend bin artifact",
            "bin": str(bin_path),
        }
    if not emu.exists() or not ref.exists():
        return {
            "id": test_id,
            "suite": test["suite"],
            "backend": "xiangshan",
            "status": "blocked_missing_artifact",
            "reason": "missing XiangShan emu or difftest reference",
            "bin": str(bin_path),
            "emu": str(emu),
            "ref": str(ref),
        }
    log_path = output_dir / "logs" / f"{test_id}.log"
    log_path.parent.mkdir(parents=True, exist_ok=True)
    command = line_buffered_command([str(emu), "-b", "0", "-e", "0", "-i", str(bin_path), "--diff", str(ref)])
    start = time.monotonic()
    with log_path.open("w", encoding="utf-8") as log:
        log.write("$ " + " ".join(command) + "\n\n")
        try:
            completed = subprocess.run(
                command,
                cwd=root / "XiangShan",
                stdout=log,
                stderr=subprocess.STDOUT,
                timeout=timeout,
                check=False,
                env=xiangshan_subprocess_env(root),
            )
            rc = completed.returncode
            timed_out = False
        except subprocess.TimeoutExpired:
            log.write(f"\nTIMEOUT after {timeout}s\n")
            rc = None
            timed_out = True
    status, reason = classify_log(log_path, rc, timed_out)
    return {
        "id": test_id,
        "suite": test["suite"],
        "backend": "xiangshan",
        "status": status,
        "reason": reason,
        "return_code": rc,
        "command": command,
        "bin": str(bin_path),
        "emu": str(emu),
        "ref": str(ref),
        "log_path": str(log_path),
        "host_time": round(time.monotonic() - start, 3),
    }


def run_spec2006_one(
    root: Path,
    entry: dict,
    output_dir: Path,
    timeout: int,
    emu: Path,
    ref: Path,
    gcpt_restorer: str | None,
    maxinsts: int | None,
    maxcycles: int | None,
    run_mode: str,
    checkpoint_end_maxinsts: int,
    dry_run: bool,
    on_eda: bool,
) -> dict:
    entry_id = entry["id"]
    checkpoint = resolve_repo_path(root, Path(entry["checkpoint"]))
    detected_layout = detect_gcpt_layout(checkpoint) if checkpoint and checkpoint.exists() else {"layout": "unknown"}
    gcpt_layout = effective_gcpt_layout(entry, detected_layout)
    rvh_checkpoint = requires_rvh_checkpoint(entry, gcpt_layout)
    h_aware_ref_required = requires_h_aware_ref(entry, gcpt_layout)
    requested_ref = ref
    ref = resolve_difftest_ref_so(root, requested_ref, h_aware_ref_required)
    restorer, restorer_policy, restorer_error = resolve_gcpt_restorer(root, entry, gcpt_restorer, gcpt_layout)
    if run_mode == "complete":
        maxinsts_value = maxinsts if maxinsts and maxinsts > 0 else int(entry.get("checkpoint_end_maxinsts") or checkpoint_end_maxinsts)
        maxinsts_policy = "checkpoint_end"
        completion_policy = "checkpoint_end_maxinsts"
    else:
        maxinsts_value = maxinsts or int(entry.get("maxinsts") or 10000)
        maxinsts_policy = "bounded_canary"
        completion_policy = "bounded_canary_after_checkpoint_entry"
    maxcycles_value = maxcycles if maxcycles and maxcycles > 0 else None
    timeout_seconds = timeout or int(entry.get("timeout_seconds") or 300)
    log_path = output_dir / "logs" / f"{entry_id}.log"
    command = line_buffered_command([str(emu), "-i", str(checkpoint), "--diff", str(ref), "-I", str(maxinsts_value)])
    if maxcycles_value is not None:
        command.extend(["-C", str(maxcycles_value)])
    if restorer is not None:
        command.extend(["-r", str(restorer)])
    base = {
        "id": entry_id,
        "suite": "spec2006",
        "benchmark": entry.get("benchmark"),
        "workload": entry.get("workload"),
        "point": entry.get("point"),
        "backend": "xiangshan",
        "checkpoint": str(checkpoint) if checkpoint else None,
        "checkpoint_metadata": entry,
        "emu": str(emu),
        "ref": str(ref),
        "gcpt_restorer": str(restorer) if restorer else None,
        "gcpt_restorer_policy": restorer_policy,
        "gcpt_layout": gcpt_layout,
        "gcpt_layout_evidence": detected_layout,
        "requires_rvh": rvh_checkpoint,
        "requires_h_aware_ref": h_aware_ref_required,
        "maxinsts": maxinsts_value,
        "maxinsts_policy": maxinsts_policy,
        "maxcycles": maxcycles_value,
        "maxcycles_policy": "debug_cycle_limit" if maxcycles_value is not None else None,
        "run_mode": run_mode,
        "completion_policy": completion_policy,
        "timeout_seconds": timeout_seconds,
        "command": command,
        "log_path": str(log_path),
        "stats_path": None,
        "started_at": None,
        "ended_at": None,
        "wall_time_seconds": None,
        "host_time": None,
        "timed_out": False,
        "killed": False,
        "dry_run": dry_run,
    }
    if checkpoint is None or not checkpoint.exists():
        return {**base, "status": "blocked_missing_artifact", "reason": "missing SPEC2006 checkpoint"}
    integrity_error = checkpoint_integrity_error(entry, checkpoint)
    if integrity_error:
        return {**base, "status": "blocked_missing_artifact", "reason": integrity_error}
    if not ref.exists():
        return {**base, "status": "blocked_missing_artifact", "reason": "missing XiangShan difftest reference"}
    if h_aware_ref_required and requested_ref is None and not os.environ.get("GCBH_REF_SO"):
        return {
            **base,
            "status": "blocked_missing_artifact",
            "reason": "embedded RVH checkpoint requires an explicit H-aware XiangShan difftest ref; pass --diff or set GCBH_REF_SO",
        }
    if restorer_error:
        return {**base, "status": "blocked_missing_artifact", "reason": restorer_error}
    if dry_run:
        return {**base, "status": "unsupported", "reason": "dry-run only"}
    if not on_eda:
        return {**base, "status": "blocked_env", "reason": "XiangShan SPEC2006 emu/difftest must run on q2 eda-00, not on this host"}
    if not emu.exists():
        return {**base, "status": "blocked_missing_artifact", "reason": "missing XiangShan emu"}
    log_path.parent.mkdir(parents=True, exist_ok=True)
    started_at = iso_now()
    start = time.monotonic()
    rc = None
    timed_out = False
    killed = False
    with log_path.open("w", encoding="utf-8") as log:
        log.write("$ " + " ".join(command) + "\n\n")
        try:
            process = subprocess.Popen(
                command,
                cwd=root / "XiangShan",
                stdout=log,
                stderr=subprocess.STDOUT,
                start_new_session=True,
                env=xiangshan_subprocess_env(root),
            )
            rc = process.wait(timeout=timeout_seconds)
        except subprocess.TimeoutExpired:
            log.write(f"\nTIMEOUT after {timeout_seconds}s\n")
            timed_out = True
            killed = terminate_process_group(process, log)
    ended_at = iso_now()
    wall_time = round(time.monotonic() - start, 3)
    status, reason = classify_log(log_path, rc, timed_out)
    difftest_evidence = difftest_log_evidence(log_path)
    gcpt_evidence = xiangshan_gcpt_log_evidence(log_path)
    log_summary = xiangshan_log_summary(log_path)
    if timed_out and status == "timeout":
        if gcpt_evidence["entered_checkpoint"] and run_mode == "bounded":
            status = "pass"
            reason = "entered checkpoint emu and reached bounded timeout"
        elif gcpt_evidence["entered_checkpoint"]:
            status = "timeout"
            reason = "entered checkpoint emu but did not reach checkpoint-end boundary before timeout"
        else:
            status = "fail"
            reason = "timed out before checkpoint emu entry"
    if status == "unsupported" and gcpt_evidence["entered_checkpoint"] and gcpt_evidence["reached_maxinsts"]:
        instr_count = log_summary.get("instrCnt")
        cycle_count = log_summary.get("cycleCnt")
        reached_instr_limit = isinstance(instr_count, int) and instr_count >= maxinsts_value
        reached_cycle_limit = maxcycles_value is not None and isinstance(cycle_count, int) and cycle_count >= maxcycles_value
        if maxcycles_value is not None and reached_cycle_limit and not reached_instr_limit:
            status = "timeout"
            reason = (
                "cycle limit reached before checkpoint-end boundary"
                if run_mode == "complete"
                else "cycle limit reached before bounded instruction boundary"
            )
        else:
            status = "pass"
            reason = (
                "checkpoint-end max instruction count reached after checkpoint entry"
                if run_mode == "complete"
                else "entered checkpoint emu and reached max instruction count"
            )
    elif run_mode == "complete" and status == "unsupported" and gcpt_evidence["entered_checkpoint"]:
        status = "fail"
        reason = "XiangShan emu exited after checkpoint entry without a complete-run marker"
    if status in {"pass", "timeout", "unsupported"} and not difftest_evidence["enabled"]:
        status = "fail"
        reason = "checkpoint run did not emit difftest enable marker"
    return {
        **base,
        "status": status,
        "reason": reason,
        "return_code": rc,
        "started_at": started_at,
        "ended_at": ended_at,
        "wall_time_seconds": wall_time,
        "host_time": wall_time,
        "timed_out": timed_out,
        "killed": killed,
        "stop_reason": reason,
        "difftest_log_evidence": difftest_evidence,
        "gcpt_log_evidence": gcpt_evidence,
        "emu_log_summary": log_summary,
        "abort_pc": log_summary.get("abort_pc"),
        "instrCnt": log_summary.get("instrCnt"),
        "cycleCnt": log_summary.get("cycleCnt"),
        "IPC": log_summary.get("IPC"),
    }


def run_spec2006(args: argparse.Namespace, root: Path, host: str, on_eda: bool) -> tuple[str, str, list[dict]]:
    if not args.manifest.exists():
        reason = "SPEC2006 checkpoint manifest is not provided"
        return "blocked_missing_artifact", reason, [{"stage": "spec2006", "status": "blocked_missing_artifact", "reason": reason}]
    manifest = load_manifest(args.manifest)
    entries = select_spec2006_entries(manifest, set(args.test), args.spec2006_canary)
    if not entries:
        reason = "no SPEC2006 checkpoint manifest entries matched requested filters"
        return "blocked_missing_artifact", reason, []
    emu = args.emu or root / "XiangShan" / "build" / "emu"
    ref = args.diff
    rows = [
        run_spec2006_one(
            root,
            entry,
            args.output.parent,
            args.per_test_timeout,
            emu,
            ref,
            args.gcpt_restorer,
            args.maxinsts,
            args.maxcycles,
            args.spec2006_run_mode,
            args.spec2006_checkpoint_end_maxinsts,
            args.dry_run,
            on_eda,
        )
        for entry in entries
    ]
    summary = summarize(rows)
    hard_statuses = ("fail", "blocked_missing_artifact", "blocked_env", "timeout", "oom") if args.spec2006_run_mode == "complete" else ("fail", "blocked_missing_artifact", "blocked_env", "oom")
    hard_blocking = sum(summary["by_status"].get(status, 0) for status in hard_statuses)
    blocking = hard_blocking + (0 if args.dry_run else summary["by_status"].get("unsupported", 0))
    if args.dry_run and hard_blocking:
        if summary["by_status"].get("blocked_missing_artifact", 0):
            return "blocked_missing_artifact", "dry-run input validation found missing artifacts", rows
        if summary["by_status"].get("blocked_env", 0):
            return "blocked_env", "dry-run input validation found environment blockers", rows
        return "fail", "dry-run input validation failed", rows
    if args.dry_run:
        return "unsupported", "dry-run only", rows
    if blocking:
        if summary["by_status"].get("blocked_missing_artifact", 0) and not summary["by_status"].get("fail", 0) and not summary["by_status"].get("blocked_env", 0):
            return "blocked_missing_artifact", "selected XiangShan SPEC2006 checkpoint entries are blocked by missing artifacts", rows
        if summary["by_status"].get("blocked_env", 0) and not summary["by_status"].get("fail", 0) and not summary["by_status"].get("blocked_missing_artifact", 0):
            return "blocked_env", "selected XiangShan SPEC2006 checkpoint entries are blocked by execution environment", rows
        if args.spec2006_run_mode == "complete":
            return "fail", "selected XiangShan SPEC2006 checkpoint entries did not satisfy checkpoint-end criteria", rows
        return "fail", "selected XiangShan SPEC2006 checkpoint entries did not satisfy canary criteria", rows
    return "pass", (
        "all selected XiangShan SPEC2006 checkpoint entries reached checkpoint-end criteria"
        if args.spec2006_run_mode == "complete"
        else "all selected XiangShan SPEC2006 checkpoint entries reached bounded canary criteria"
    ), rows


def main(argv: list[str]) -> int:
    root = repo_root()
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--stage", choices=("isa", "medium", "spec2006"), required=True)
    parser.add_argument("--manifest", type=Path, default=root / "baremetal" / "riscv-tests" / "isa" / "build" / "manifest.json")
    parser.add_argument("--output", type=Path, default=None)
    parser.add_argument("--repo-root", type=Path, default=root)
    parser.add_argument("--test", action="append", default=[], help="test filter: name, suite/name, or manifest id")
    parser.add_argument("--suite", choices=(SUPPORTED_SUITE_ID,), default=None, help="shared test suite to select before --test filtering")
    parser.add_argument(
        "--suite-source",
        type=Path,
        default=root / "build" / "validation" / "l3-gem5" / "isa" / "results.json",
        help="GEM5 ISA result JSON used to derive supported-cross-77",
    )
    parser.add_argument("--per-test-timeout", type=int, default=300)
    parser.add_argument("--emu", type=Path, default=None)
    parser.add_argument("--diff", type=Path, default=None)
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--spec2006-canary", action="store_true", help="select the manifest canary entry for --stage spec2006")
    parser.add_argument("--gcpt-restorer", default="auto", help="GCPT restorer policy for SPEC2006: auto, none, or a path")
    parser.add_argument("--maxinsts", type=int, default=None, help="bounded instruction limit for SPEC2006 checkpoint canaries")
    parser.add_argument("--maxcycles", "--max-cycles", type=int, default=None, help="optional SPEC2006 emu cycle limit passed through as -C")
    parser.add_argument("--spec2006-run-mode", choices=("bounded", "complete"), default="bounded", help="bounded keeps canary maxinsts semantics; complete runs until the checkpoint-end instruction boundary")
    parser.add_argument("--spec2006-checkpoint-end-maxinsts", type=int, default=SPEC2006_DEFAULT_CHECKPOINT_END_MAXINSTS, help="complete-mode instruction boundary that marks the end of the checkpoint sample")
    args = parser.parse_args(argv)
    root = args.repo_root.resolve()
    if args.output is None:
        if args.stage == "spec2006" and args.maxcycles is not None and args.maxcycles > 0:
            args.output = root / "build" / "validation" / "l3-xiangshan" / "spec2006-cycle-debug" / "results.json"
        elif args.stage == "spec2006" and args.spec2006_run_mode == "complete":
            args.output = root / "build" / "validation" / "l3-xiangshan" / "spec2006-full-difftest" / "results.json"
        elif args.stage == "spec2006":
            args.output = root / "build" / "validation" / "l3-xiangshan" / "spec2006" / "results.json"
        else:
            args.output = root / "build" / "validation" / "l3-xiangshan" / args.stage / "results.json"
    host = socket.gethostname()
    on_eda = host == "eda-00" or "eda-00" in host
    tests: list[dict] = []
    if args.stage != "spec2006" and args.manifest.exists():
        filters = set(args.test)
        tests = select_manifest_tests(load_manifest(args.manifest), filters, args.suite, args.suite_source, args.manifest)
    if args.stage == "spec2006":
        status, reason, rows = run_spec2006(args, root, host, on_eda)
    elif args.stage != "isa":
        reason = "XiangShan medium stages are not wired for RV64 sample runner"
        rows = blocked_rows(tests, reason, "unsupported")
        status = "unsupported"
    elif args.dry_run:
        reason = "dry-run only"
        rows = [
            {
                "id": test["id"],
                "suite": test["suite"],
                "backend": "xiangshan",
                "status": "unsupported",
                "reason": reason,
                "bin": str(artifact_for_backend(root, test, "xiangshan")),
            }
            for test in tests
        ]
        status = "unsupported"
    elif not on_eda:
        reason = "XiangShan full-system emu/difftest must run on q2 eda-00, not on this host"
        rows = blocked_rows(tests, reason, "blocked_env")
        status = "blocked_env"
    elif not tests:
        reason = "no manifest entries matched requested tests"
        rows = []
        status = "blocked_missing_artifact"
    else:
        emu = args.emu or root / "XiangShan" / "build" / "emu"
        ref = args.diff or root / "XiangShan" / "ready-to-run" / "riscv64-nemu-interpreter-so"
        rows = [run_one(root, test, args.output.parent, args.per_test_timeout, emu, ref) for test in tests]
        summary = summarize(rows)
        status = "pass" if summary["total"] and summary["by_status"].get("pass", 0) == summary["total"] else "fail"
        reason = "all selected XiangShan entries passed" if status == "pass" else "selected XiangShan entries did not fully pass"
    summary = summarize(rows)
    payload = {
        "schema_version": 1,
        "layer": "l3",
        "target": spec2006_target(args.spec2006_run_mode, args.maxcycles) if args.stage == "spec2006" else "xiangshan-emu",
        "stage": args.stage,
        "run_mode": args.spec2006_run_mode if args.stage == "spec2006" else None,
        "host": host,
        "suite": args.suite,
        "suite_source": str(args.suite_source) if args.suite else None,
        "manifest": str(args.manifest) if args.stage == "spec2006" else None,
        "status": status,
        "reason": reason,
        "summary": summary,
        "results": rows,
    }
    write_payload(args.output, payload)
    return 0 if status in {"pass", "unsupported", "blocked_env"} else 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
