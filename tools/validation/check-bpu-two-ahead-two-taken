STATE_ALIASES = {
    "predict_response": "allocated",
    "resolve": "resolved",
    "train": "trained",
    "commit": "committed",
}

TWO_FETCH_MODES = {"two_fetch", "two-fetch", "2fetch", "2-fetch"}


def is_two_fetch_mode(event: dict[str, Any]) -> bool:
    return str(event.get("mode", "")).lower() in TWO_FETCH_MODES


def parse_positive_int(value: Any, field: str, errors: list[str], idx: int) -> int | None:
    if isinstance(value, bool) or not isinstance(value, int):
        errors.append(f"event[{idx}] {field} must be a positive integer")
        return None
    if value <= 0:
        errors.append(f"event[{idx}] {field} must be positive")
        return None
    return value


def iter_events(path: Path | None, use_sample: bool) -> Iterator[tuple[int, Any]]:
    if use_sample:
        yield from enumerate(SAMPLE_EVENTS)
        return
    if path is None:
        raise ValueError("either --sample or --input is required")
    if path.suffix == ".jsonl":
        with path.open(encoding="utf-8") as stream:
            for idx, line in enumerate(stream):
                if line.strip():
                    yield idx, json.loads(line)
        return
    data = json.loads(path.read_text(encoding="utf-8"))
    events = data["events"] if isinstance(data, dict) and "events" in data else data
    yield from enumerate(events)


def parse_addr(value: Any, field: str, errors: list[str], idx: int) -> int | None:
    if isinstance(value, bool):
        errors.append(f"event[{idx}] {field} must be an address, got bool")
        return None
    if isinstance(value, int):
        return value
    if isinstance(value, str):
        try:
            return int(value, 0)
        except ValueError:
            errors.append(f"event[{idx}] {field} is not a valid address: {value!r}")
            return None
    errors.append(f"event[{idx}] {field} must be int or 0x string")
    return None


def required(mapping: dict[str, Any], fields: set[str], prefix: str, errors: list[str]) -> bool:
    missing = fields - set(mapping)
    if missing:
        errors.append(f"{prefix} missing fields: {sorted(missing)}")
        return False
    return True


def validate_predict_response(idx: int, event: dict[str, Any]) -> list[str]:
    errors: list[str] = []
    required(
        event,
        {
            "pc",
            "target",
            "taken",
            "fetch_id",
            "metadata_id",
            "epoch",
            "ahead_windows",
            "taken_slots",
        },
        f"event[{idx}] predict_response",
        errors,
    )
    if errors:
        return errors

    event_pc = parse_addr(event["pc"], "pc", errors, idx)
    event_target = parse_addr(event["target"], "target", errors, idx)
    epoch = event["epoch"]

    windows = event["ahead_windows"]
    if not isinstance(windows, list) or not 1 <= len(windows) <= 2:
        errors.append(f"event[{idx}] ahead_windows must contain one or two windows")
        return errors

    window_by_slot: dict[int, dict[str, Any]] = {}
    valid_window_slots: set[int] = set()
    for widx, window in enumerate(windows):
        if not isinstance(window, dict):
            errors.append(f"event[{idx}] ahead_windows[{widx}] must be an object")
            continue
        if not required(
            window,
            {"slot", "valid", "pc", "fallthrough", "source", "epoch"},
            f"event[{idx}] ahead_windows[{widx}]",
            errors,
        ):
            continue
        slot = window["slot"]
        if slot not in (0, 1):
            errors.append(f"event[{idx}] ahead_windows[{widx}] slot must be 0 or 1")
            continue
        if slot in window_by_slot:
            errors.append(f"event[{idx}] duplicate ahead window slot {slot}")
            continue
        window_by_slot[slot] = window
        if window["epoch"] != epoch:
            errors.append(f"event[{idx}] ahead_windows[{widx}] epoch does not match event epoch")
        pc = parse_addr(window["pc"], f"ahead_windows[{widx}].pc", errors, idx)
        fallthrough = parse_addr(window["fallthrough"], f"ahead_windows[{widx}].fallthrough", errors, idx)
        if window.get("valid"):
            valid_window_slots.add(slot)
            if pc is not None and fallthrough is not None and pc >= fallthrough:
                errors.append(f"event[{idx}] ahead_windows[{widx}] fallthrough must be greater than pc")

    window0 = window_by_slot.get(0)
    if window0 is None or not window0.get("valid"):
        errors.append(f"event[{idx}] window slot 0 must be present and valid")
        return errors
    window0_pc = parse_addr(window0["pc"], "ahead_windows[slot=0].pc", errors, idx)
    window0_fallthrough = parse_addr(
        window0["fallthrough"], "ahead_windows[slot=0].fallthrough", errors, idx
    )
    if event_pc is not None and window0_pc is not None and event_pc != window0_pc:
        errors.append(f"event[{idx}] window0 pc must match predict_response pc")

    taken_slots = event["taken_slots"]
    if not isinstance(taken_slots, list) or len(taken_slots) == 0:
        errors.append(f"event[{idx}] taken_slots must be a non-empty list")
        return errors

    valid_taken: list[dict[str, Any]] = []
    seen_taken_slots: set[int] = set()
    for sidx, slot in enumerate(taken_slots):
        if not isinstance(slot, dict):
            errors.append(f"event[{idx}] taken_slots[{sidx}] must be an object")
            continue
        if not required(slot, {"slot", "valid"}, f"event[{idx}] taken_slots[{sidx}]", errors):
            continue
        slot_id = slot["slot"]
        if not isinstance(slot_id, int) or slot_id < 0:
            errors.append(f"event[{idx}] taken_slots[{sidx}] slot must be a non-negative integer")
            continue
        if slot_id in seen_taken_slots:
            errors.append(f"event[{idx}] duplicate taken slot {slot_id}")
            continue
        seen_taken_slots.add(slot_id)
        if not slot.get("valid"):
            continue
        if not required(
            slot,
            {"window_slot", "pc", "target", "source", "epoch"},
            f"event[{idx}] taken_slots[{sidx}]",
            errors,
        ):
            continue
        if slot["epoch"] != epoch:
            errors.append(f"event[{idx}] taken_slots[{sidx}] epoch does not match event epoch")
        window_slot = slot["window_slot"]
        if window_slot not in valid_window_slots:
            errors.append(f"event[{idx}] taken_slots[{sidx}] references invalid window_slot {window_slot}")
            continue
        branch_pc = parse_addr(slot["pc"], f"taken_slots[{sidx}].pc", errors, idx)
        target = parse_addr(slot["target"], f"taken_slots[{sidx}].target", errors, idx)
        window = window_by_slot[window_slot]
        window_pc = parse_addr(window["pc"], f"window[{window_slot}].pc", errors, idx)
        window_fallthrough = parse_addr(
            window["fallthrough"], f"window[{window_slot}].fallthrough", errors, idx
        )
        if (
            branch_pc is not None
            and window_pc is not None
            and window_fallthrough is not None
            and not (window_pc <= branch_pc < window_fallthrough)
        ):
            errors.append(
                f"event[{idx}] taken_slots[{sidx}] pc is outside its ahead window range"
            )
        if target is not None:
            valid_taken.append(slot)

    if len(valid_taken) > 2:
        errors.append(f"event[{idx}] has {len(valid_taken)} valid taken slots, maximum is 2")

    expected_order = sorted(
        valid_taken,
        key=lambda slot: (
            int(slot["window_slot"]),
            parse_addr(slot["pc"], "taken_slots.pc", errors, idx) or -1,
        ),
    )
    if valid_taken != expected_order:
        errors.append(f"event[{idx}] taken slots are not in window/program order")
    for expected_slot, slot in enumerate(valid_taken):
        if slot.get("slot") != expected_slot:
            errors.append(
                f"event[{idx}] valid taken slot order must be dense from 0; "
                f"got slot {slot.get('slot')} at position {expected_slot}"
            )

    window1 = window_by_slot.get(1)
    if window1 is not None and window1.get("valid"):
        window1_pc = parse_addr(window1["pc"], "ahead_windows[slot=1].pc", errors, idx)
        allowed_next_pcs: set[int] = set()
        if window0_fallthrough is not None:
            allowed_next_pcs.add(window0_fallthrough)
        if valid_taken and valid_taken[0].get("window_slot") == 0:
            first_target = parse_addr(valid_taken[0]["target"], "taken_slots[0].target", errors, idx)
            if first_target is not None:
                allowed_next_pcs.add(first_target)
        if window1_pc is not None and window1_pc not in allowed_next_pcs:
            allowed = [hex(value) for value in sorted(allowed_next_pcs)]
            errors.append(
                f"event[{idx}] window1 pc {hex(window1_pc)} is not derived from "
                f"window0 fallthrough or first taken target: {allowed}"
            )

    if valid_taken:
        first_target = parse_addr(valid_taken[0]["target"], "taken_slots[0].target", errors, idx)
        if event.get("taken") is not True:
            errors.append(f"event[{idx}] predict_response must be taken when slot0 is valid")
        if event_target is not None and first_target is not None and event_target != first_target:
            errors.append(f"event[{idx}] predict_response target must match slot0 target")
    else:
        if event.get("taken") is not False:
            errors.append(f"event[{idx}] predict_response must be fall-through when no taken slot is valid")
        if (
            event_target is not None
            and window0_fallthrough is not None
            and event_target != window0_fallthrough
        ):
            errors.append(f"event[{idx}] fall-through target must match window0 fallthrough")

    if event.get("mode") == "functional":
        consumed = int(event.get("functional_consumed_windows", 0))
        if event.get("consumed_second_window"):
            consumed = max(consumed, 2)
        if consumed > 1 and not event.get("functional_consume_evidence"):
            errors.append(
                f"event[{idx}] functional trace consumed window1 without consume evidence"
            )

    if is_two_fetch_mode(event):
        if not required(
            event,
            {
                "two_fetch_batch_id",
                "two_fetch_batch_size",
                "two_fetch_window_slot",
                "two_fetch_materialized",
            },
            f"event[{idx}] two_fetch predict_response",
            errors,
        ):
            return errors
        batch_size = parse_positive_int(
            event.get("two_fetch_batch_size"),
            "two_fetch_batch_size",
            errors,
            idx,
        )
        window_slot = event.get("two_fetch_window_slot")
        if window_slot not in (0, 1):
            errors.append(f"event[{idx}] two_fetch_window_slot must be 0 or 1")
        if batch_size is not None and batch_size > 2:
            errors.append(f"event[{idx}] two_fetch_batch_size must not exceed 2")
        if event.get("two_fetch_materialized") is not True:
            errors.append(f"event[{idx}] two_fetch predict_response must be materialized")
        if window_slot == 1 and "two_fetch_parent_fetch_id" not in event:
            errors.append(f"event[{idx}] window1 two_fetch entry missing parent fetch id")
        prediction_kind = event.get("two_fetch_prediction_kind")
        predictor_backed = event.get("two_fetch_predictor_backed")
        prediction_accepted = event.get("two_fetch_prediction_accepted")
        if prediction_kind is not None and prediction_kind not in {
            "synthetic_fallback",
            "predictor_backed_candidate",
            "predictor_backed_accepted",
            "none",
        }:
            errors.append(f"event[{idx}] invalid two_fetch_prediction_kind {prediction_kind!r}")
        if prediction_kind == "predictor_backed_accepted":
            if predictor_backed is not True:
                errors.append(
                    f"event[{idx}] predictor-backed accepted window1 must set two_fetch_predictor_backed"
                )
            if prediction_accepted is not True:
                errors.append(
                    f"event[{idx}] predictor-backed accepted window1 must set two_fetch_prediction_accepted"
                )
            if window_slot == 1 and "two_fetch_pred_hit" not in event:
                errors.append(f"event[{idx}] predictor-backed window1 missing hit evidence")
        if prediction_kind == "synthetic_fallback" and predictor_backed is True:
            errors.append(f"event[{idx}] synthetic fallback must not be marked predictor-backed")

    return errors


def validate(
    events: Iterable[tuple[int, Any]],
    *,
    allow_live_tail: int = 0,
) -> tuple[str, list[str], dict[str, Any]]:
    errors: list[str] = []
    predictions: dict[str, dict[str, Any]] = {}
    states: dict[str, set[str]] = {}
    invalidated_metadata_ids: set[str] = set()
    flushed_metadata_sample: list[str] = []
    flushed_metadata_sample_limit = 1000
    metadata_count = 0
    event_count = 0
    predict_response_count = 0
    full_lifecycle_found = False
    two_fetch_batches_expected: set[str] = set()
    two_fetch_batches_with_window1: set[str] = set()
    two_fetch_batches_consumed: set[str] = set()
    two_fetch_window1_metadata: dict[str, str] = {}
    two_fetch_window1_metadata_info: dict[str, dict[str, Any]] = {}
    two_fetch_window1_metadata_consumed: set[str] = set()
    two_fetch_predict_response_count = 0
    two_fetch_window1_materialized_count = 0
    two_fetch_window1_consume_count = 0

    def record_flushed(metadata_id: str) -> None:
        if metadata_id in invalidated_metadata_ids:
            return
        invalidated_metadata_ids.add(metadata_id)
        if len(flushed_metadata_sample) < flushed_metadata_sample_limit:
            flushed_metadata_sample.append(metadata_id)

    for idx, event in enumerate(events):
        if isinstance(event, tuple) and len(event) == 2:
            idx, event = event
        event_count += 1
        if not isinstance(event, dict):
            errors.append(f"event[{idx}] must be an object")
            continue
        etype = event.get("event")
        metadata_id = event.get("metadata_id")
        metadata_id_s = str(metadata_id) if metadata_id is not None else None
        if metadata_id_s is not None and metadata_id_s in states:
            metadata_id_s = str(metadata_id)
            state = str(event.get("metadata_state", STATE_ALIASES.get(str(etype), str(etype))))
            states[metadata_id_s].add(state)

        if etype == "predict_response":
            predict_response_count += 1
            errors.extend(validate_predict_response(idx, event))
            if metadata_id_s is not None:
                metadata_count += 1
                predictions[metadata_id_s] = {
                    "fetch_id": event.get("fetch_id"),
                    "epoch": event.get("epoch"),
                }
                states.setdefault(metadata_id_s, set()).add("allocated")
            if is_two_fetch_mode(event):
                two_fetch_predict_response_count += 1
                batch_id = str(event.get("two_fetch_batch_id"))
                batch_size = event.get("two_fetch_batch_size")
                window_slot = event.get("two_fetch_window_slot")
                if isinstance(batch_size, int) and batch_size >= 2:
                    two_fetch_batches_expected.add(batch_id)
                if window_slot == 1:
                    two_fetch_window1_materialized_count += 1
                    two_fetch_batches_with_window1.add(batch_id)
                    if metadata_id_s is not None:
                        two_fetch_window1_metadata[metadata_id_s] = batch_id
                        two_fetch_window1_metadata_info[metadata_id_s] = {
                            "batch_id": batch_id,
                            "cycle": event.get("cycle"),
                            "event_index": idx,
                            "fetch_id": event.get("fetch_id"),
                        }
        elif etype == "flush":
            metadata_to_drop: set[str] = set()
            for mid in event.get("invalidated_metadata_ids", []):
                mid_s = str(mid)
                record_flushed(mid_s)
                if mid_s in states:
                    states[mid_s].add("flushed")
                metadata_to_drop.add(mid_s)
            begin = event.get("begin_fetch_id")
            end = event.get("end_fetch_id")
            if isinstance(begin, int) and isinstance(end, int):
                for mid, pred in predictions.items():
                    fetch_id = pred.get("fetch_id")
                    if isinstance(fetch_id, int) and begin <= fetch_id <= end:
                        record_flushed(mid)
                        if mid in states:
                            states[mid].add("flushed")
                        metadata_to_drop.add(mid)
            for mid in metadata_to_drop:
                predictions.pop(mid, None)
                states.pop(mid, None)
        elif etype == "train":
            if metadata_id is None:
                errors.append(f"event[{idx}] train missing metadata_id")
                continue
            pred = predictions.get(metadata_id_s)
            if pred is None:
                if metadata_id_s in invalidated_metadata_ids:
                    errors.append(f"event[{idx}] train references flushed metadata_id {metadata_id_s}")
                else:
                    errors.append(f"event[{idx}] train references unknown metadata_id {metadata_id_s}")
                continue
            if metadata_id_s in invalidated_metadata_ids:
                errors.append(f"event[{idx}] train references flushed metadata_id {metadata_id_s}")
            if event.get("epoch") != pred.get("epoch"):
                errors.append(f"event[{idx}] train epoch does not match prediction epoch")
        elif etype == "commit" and metadata_id_s is not None:
            metadata_states = states.get(metadata_id_s, set())
            if {"allocated", "resolved", "trained", "committed"} <= metadata_states:
                full_lifecycle_found = True
            predictions.pop(metadata_id_s, None)
            states.pop(metadata_id_s, None)
        elif etype in {"fetch_consume", "fetch_window_consume"}:
            window_slot = event.get("two_fetch_window_slot", event.get("window_slot"))
            if window_slot == 1:
                two_fetch_window1_consume_count += 1
                batch_id = event.get("two_fetch_batch_id")
                if batch_id is not None:
                    two_fetch_batches_consumed.add(str(batch_id))
                if metadata_id_s is not None:
                    two_fetch_window1_metadata_consumed.add(metadata_id_s)
                consumed_insts = event.get("consumed_insts", event.get("insts"))
                if not isinstance(consumed_insts, int) or consumed_insts <= 0:
                    errors.append(
                        f"event[{idx}] window1 consume evidence must report positive consumed_insts"
                    )

    if predict_response_count == 0:
        errors.append("trace must contain at least one predict_response")

    if not full_lifecycle_found:
        errors.append(
            "metadata lifecycle must include allocated/resolved/trained/committed "
            "for at least one non-flushed metadata_id"
        )

    two_fetch_window1_metadata_flushed = {
        metadata_id
        for metadata_id in two_fetch_window1_metadata
        if metadata_id in invalidated_metadata_ids
    }
    two_fetch_batches_flushed = {
        batch_id
        for metadata_id, batch_id in two_fetch_window1_metadata.items()
        if metadata_id in invalidated_metadata_ids
    }
    unresolved_window1_metadata: list[tuple[int, int, str, str]] = []
    for metadata_id, batch_id in two_fetch_window1_metadata.items():
        if (
            metadata_id in two_fetch_window1_metadata_consumed
            or batch_id in two_fetch_batches_consumed
            or metadata_id in two_fetch_window1_metadata_flushed
        ):
            continue
        info = two_fetch_window1_metadata_info.get(metadata_id, {})
        cycle = info.get("cycle")
        fetch_id = info.get("fetch_id")
        unresolved_window1_metadata.append(
            (
                cycle if isinstance(cycle, int) else -1,
                fetch_id if isinstance(fetch_id, int) else -1,
                metadata_id,
                batch_id,
            )
        )
    live_tail_allowed_metadata = {
        metadata_id
        for _, _, metadata_id, _ in sorted(unresolved_window1_metadata, reverse=True)[:allow_live_tail]
    }
    live_tail_allowed_batches = {
        batch_id
        for _, _, metadata_id, batch_id in unresolved_window1_metadata
        if metadata_id in live_tail_allowed_metadata
    }

    for batch_id in sorted(two_fetch_batches_expected):
        if batch_id not in two_fetch_batches_with_window1:
            errors.append(f"two_fetch batch {batch_id} declared two windows but no window1 entry was materialized")
        if (
            batch_id not in two_fetch_batches_consumed
            and batch_id not in two_fetch_batches_flushed
            and batch_id not in live_tail_allowed_batches
        ):
            errors.append(
                f"two_fetch batch {batch_id} materialized window1 without fetch consume or flush evidence"
            )
    for metadata_id, batch_id in sorted(two_fetch_window1_metadata.items()):
        if (
            metadata_id not in two_fetch_window1_metadata_consumed
            and batch_id not in two_fetch_batches_consumed
            and metadata_id not in two_fetch_window1_metadata_flushed
            and metadata_id not in live_tail_allowed_metadata
        ):
            errors.append(
                f"two_fetch window1 metadata_id {metadata_id} has no fetch consume or flush evidence"
            )

    error_count = len(errors)
    if error_count > 1000:
        errors = errors[:1000] + [f"{error_count - 1000} additional errors truncated"]

    details = {
        "event_count": event_count,
        "error_count": error_count,
        "predict_response_count": predict_response_count,
        "metadata_count": metadata_count,
        "flushed_metadata_count": len(invalidated_metadata_ids),
        "flushed_metadata_ids": sorted(flushed_metadata_sample),
        "flushed_metadata_ids_truncated": len(invalidated_metadata_ids) > len(flushed_metadata_sample),
        "two_fetch_predict_response_count": two_fetch_predict_response_count,
        "two_fetch_batches_requiring_consume": len(two_fetch_batches_expected),
        "two_fetch_batches_flushed_count": len(two_fetch_batches_flushed),
        "two_fetch_window1_materialized_count": two_fetch_window1_materialized_count,
        "two_fetch_window1_consume_count": two_fetch_window1_consume_count,
        "two_fetch_window1_flushed_count": len(two_fetch_window1_metadata_flushed),
        "two_fetch_window1_live_tail_allowed_count": len(live_tail_allowed_metadata),
        "two_fetch_window1_unresolved_count": len(unresolved_window1_metadata),
    }
    return ("pass" if error_count == 0 else "fail"), errors, details


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--sample", action="store_true")
    parser.add_argument("--input", type=Path)
    parser.add_argument(
        "--output",
        type=Path,
        default=Path("build/validation/bpu-two-ahead-two-taken/results.json"),
    )
    parser.add_argument(
        "--expect-fail",
        action="store_true",
        help="Return success only if the semantic checker reports fail.",
    )
    parser.add_argument(
        "--allow-live-tail",
        type=int,
        default=0,
        help=(
            "Allow up to N newest materialized window1 entries to remain live at "
            "the end of a bounded trace. Default 0 keeps complete-trace validation strict."
        ),
    )
    args = parser.parse_args(argv)
    if args.allow_live_tail < 0:
        parser.error("--allow-live-tail must be non-negative")

    try:
        status, errors, details = validate(
            iter_events(args.input, args.sample),
            allow_live_tail=args.allow_live_tail,
        )
    except Exception as exc:
        status, errors, details = "fail", [str(exc)], {}

    expectation_status = "not_applicable"
    if args.expect_fail:
        expectation_status = "met" if status == "fail" else "unmet"

    payload = {
        "schema_version": 2,
        "layer": "l2",
        "target": "bpu-two-ahead-two-taken",
        "status": status,
        "expectation": "fail" if args.expect_fail else "pass",
        "expectation_status": expectation_status,
        "errors": errors,
        **details,
    }
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    print(json.dumps(payload, indent=2, sort_keys=True))
    print(f"VALIDATION_STATUS={status}")
    print("VALIDATION_REASON=bpu 2-ahead 2-taken semantics")
    if args.expect_fail:
        print(f"VALIDATION_EXPECTATION={expectation_status}")
        return 0 if expectation_status == "met" else 1
    return 0 if status == "pass" else 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
