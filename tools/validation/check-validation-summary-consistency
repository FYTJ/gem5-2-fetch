def main() -> int:
    collector = load_collector()
    checks = [
        check_blocked_detail_overrides_pass,
        check_direct_run_passes,
        check_non_pass_stats_are_debug_only,
        check_pass_without_metrics_is_not_performance_valid,
        check_spec2006_missing_artifact_contract,
        check_medium_missing_artifact_is_not_unsupported,
        check_eda00_smoke_overrides_local_guard,
        check_xiangshan_complete_suite_overrides_smoke,
        check_wally_l3_suite_is_separate_from_matrix,
        check_gem5_supported_suite_overrides_full_manifest,
        check_gem5_enable_difftest_eda00_is_separate_gate,
        check_gem5_linux_aarch64_spike_difftest_is_separate_gate,
    ]
    for check in checks:
        check(collector)
        print(f"PASS {check.__name__}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
