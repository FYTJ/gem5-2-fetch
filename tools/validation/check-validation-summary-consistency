#!/usr/bin/env python3
"""Regression checks for validation status aggregation and performance validity."""

from __future__ import annotations

import importlib.util
import json
import tempfile
from pathlib import Path
from importlib.machinery import SourceFileLoader


def repo_root() -> Path:
    return Path(__file__).resolve().parents[2]


def load_collector():
    path = repo_root() / "tools" / "validation" / "collect-validation-results"
    loader = SourceFileLoader("collect_validation_results", str(path))
    spec = importlib.util.spec_from_loader("collect_validation_results", loader)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot load collector from {path}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def write_json(root: Path, rel: str, payload: dict) -> None:
    path = root / rel
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def harness_result(status: str, target: str = "wally-benchmark", **extra) -> dict:
    row = {
        "layer": "l25",
        "target": target,
        "workload": "fixture",
        "host": "linux",
        "status": status,
        "return_code": 0 if status == "pass" else 1,
        "exit_reason": "fixture",
        "log_path": "fixture.log",
        "stats_path": None,
        "simInsts": None,
        "instrCnt": None,
        "cycles": None,
        "IPC": None,
        "host_time": 1.0,
    }
    row.update(extra)
    return {"schema_version": 1, "results": [row]}


def check_blocked_detail_overrides_pass(collector) -> None:
    with tempfile.TemporaryDirectory() as tmp:
        root = Path(tmp)
        write_json(root, "build/validation/task004-wally-benchmark/results.json", harness_result("pass"))
        write_json(root, "build/validation/wally-benchmark/results.json", {"benchmark": {"status": "blocked_env"}})
        payload = collector.build_summary(root)
        assert payload["gate_summary"]["blocked_env"] == 1, payload["gate_summary"]
        assert payload["gate_summary"]["pass"] == 0, payload["gate_summary"]
        assert payload["inconsistent_statuses"], payload
        item = payload["inconsistent_statuses"][0]
        assert item["target"] == "wally-benchmark", item
        assert item["harness_status"] == "pass", item
        assert item["effective_status"] == "blocked_env", item


def check_direct_run_passes(collector) -> None:
    with tempfile.TemporaryDirectory() as tmp:
        root = Path(tmp)
        write_json(root, "build/validation/task004-wally-benchmark/results.json", harness_result("pass"))
        write_json(root, "build/validation/wally-benchmark/results.json", {"benchmark": {"status": "direct_run"}})
