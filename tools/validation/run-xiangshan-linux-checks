#!/usr/bin/env python3
"""Run non-full-system XiangShan checks on the linux host and preserve blockers."""

from __future__ import annotations

import argparse
import json
import shutil
import subprocess
import sys
import time
from pathlib import Path


TEST_CLASSES = (
    "xiangshan.frontend.bpu.SaturateCounterTest",
    "xiangshan.frontend.bpu.SignedSaturateCounterTest",
)


def repo_root_from_xiangshan() -> Path:
    cwd = Path.cwd().resolve()
    return cwd.parent if cwd.name == "XiangShan" else cwd


def run(command: list[str], cwd: Path, log_path: Path, timeout: int) -> tuple[str, int | None, float]:
    log_path.parent.mkdir(parents=True, exist_ok=True)
    start = time.monotonic()
    with log_path.open("w", encoding="utf-8") as log:
        log.write("$ " + " ".join(command) + "\n\n")
        try:
            completed = subprocess.run(command, cwd=cwd, stdout=log, stderr=subprocess.STDOUT, timeout=timeout, check=False)
            rc = completed.returncode
            return ("pass" if rc == 0 else "fail"), rc, round(time.monotonic() - start, 3)
        except subprocess.TimeoutExpired:
            log.write(f"\nTIMEOUT after {timeout}s\n")
            return "timeout", None, round(time.monotonic() - start, 3)


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--mode", choices=("compile", "bpu-scalatest"), required=True)
    parser.add_argument("--output", type=Path, default=None)
    parser.add_argument("--timeout", type=int, default=900)
    args = parser.parse_args(argv)

    root = repo_root_from_xiangshan()
    xiangshan = root / "XiangShan"
    output = args.output or (root / "build" / "validation" / f"xiangshan-linux-{args.mode}" / "results.json")
    records = []
    status = "pass"
    reason = args.mode

    if not xiangshan.is_dir():
        status = "blocked_missing_artifact"
        reason = f"missing {xiangshan}"
    elif shutil.which("mill") is None:
        status = "blocked_env"
        reason = "mill not found on linux host"
    elif shutil.which("java") is None:
        status = "blocked_env"
        reason = "java not found on linux host"
    else:
        if args.mode == "compile":
            command = ["mill", "-i", "xiangshan.compile"]
            log = output.parent / "xiangshan.compile.log"
            status, rc, elapsed = run(command, xiangshan, log, args.timeout)
            records.append({"name": "xiangshan.compile", "command": command, "status": status, "return_code": rc, "log_path": str(log), "host_time": elapsed})
        else:
            for klass in TEST_CLASSES:
                command = ["mill", "-i", "xiangshan.test.testOnly", klass]
                log = output.parent / f"{klass.split('.')[-1]}.log"
                item_status, rc, elapsed = run(command, xiangshan, log, args.timeout)
                if item_status != "pass" and status == "pass":
                    status = item_status
                records.append({"name": klass, "command": command, "status": item_status, "return_code": rc, "log_path": str(log), "host_time": elapsed})

    payload = {"schema_version": 1, "layer": "l1", "target": f"xiangshan-linux-{args.mode}", "status": status, "reason": reason, "results": records}
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    print(json.dumps(payload, indent=2, sort_keys=True))
    print(f"VALIDATION_STATUS={status}")
    print(f"VALIDATION_REASON={reason}")
    return 0 if status == "pass" else 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
