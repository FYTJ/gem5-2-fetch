def classify_log(log_path: Path, rc: int | None, timed_out: bool) -> tuple[str, str]:
    text = log_path.read_text(encoding="utf-8", errors="replace") if log_path.exists() else ""
    if timed_out:
        if "Entering event queue" in text or "Starting simulation" in text:
            return "timeout", "entered simulation but did not reach the selected exit protocol before timeout"
        return "timeout", "timed out before clear simulation entry"
    if "cannot open shared object file" in text and "for difftest" in text:
        return "blocked_missing_artifact", "difftest reference shared library could not be loaded"
    if "wrong ELF class" in text or "Exec format error" in text:
        return "blocked_env", "difftest reference shared library is incompatible with the host architecture"
    if "Difftest" in text and "different" in text:
        return "fail", "difftest mismatch detected"
    if "No valid ref_so file specified" in text or "difftest_ref_so" in text and "fatal" in text.lower():
        return "blocked_missing_artifact", "difftest reference shared library was not resolved"
    if "Commit stage is stucked" in text:
        return "fail", "gem5 commit stage stuck after checkpoint restore"
    if "panic:" in text.lower() and "difftest" in text.lower():
        return "fail", "difftest panic"
    if "m5_fail instruction encountered" in text:
        return "fail", "m5_fail instruction encountered"
    if rc != 0:
        return "fail", "gem5 returned non-zero"
    if "m5_exit instruction encountered" in text:
        return "pass", "m5_exit instruction encountered"
    if "HIT GOOD TRAP" in text or "good trap" in text.lower():
        return "pass", "good trap"
    if "Exiting @ tick" in text or "simulate() limit reached" in text:
        return "unsupported", "gem5 exited without recognized riscv-tests pass/fail protocol"
    return "unsupported", "no recognized pass/fail marker"


def oom_log_evidence(log_path: Path, rc: int | None, timed_out: bool, killed_by_runner: bool, time_log_path: Path | None = None) -> dict:
    text = log_path.read_text(encoding="utf-8", errors="replace") if log_path.exists() else ""
    time_text = time_log_path.read_text(encoding="utf-8", errors="replace") if time_log_path and time_log_path.exists() else ""
    combined = "\n".join([text, time_text]).lower()
    markers = [
        "out of memory",
        "oom-kill",
        "oom killer",
        "killed process",
        "cannot allocate memory",
        "std::bad_alloc",
        "memoryerror",
    ]
    marker_line = None
    for line in (text + "\n" + time_text).splitlines():
        lowered = line.lower()
        if any(marker in lowered for marker in markers):
            marker_line = line.strip()
            break
    sigkill_without_timeout = rc == -signal.SIGKILL and not timed_out and not killed_by_runner
    shell_killed_line = marker_line is None and "\nkilled\n" in f"\n{combined}\n" and not killed_by_runner
    detected = marker_line is not None or sigkill_without_timeout or shell_killed_line
    if marker_line:
        reason = marker_line
    elif sigkill_without_timeout:
        reason = "process exited with SIGKILL without runner timeout kill; possible OOM kill"
    elif shell_killed_line:
        reason = "log contains bare Killed marker without runner timeout kill"
    else:
        reason = None
    return {
        "detected": detected,
        "reason": reason,
        "return_code": rc,
        "timed_out": timed_out,
        "killed_by_runner": killed_by_runner,
        "time_log_path": str(time_log_path) if time_log_path else None,
    }


def gnu_time_prefix(time_log_path: Path) -> list[str]:
    time_bin = Path("/usr/bin/time")
    if not time_bin.exists():
        return []
    try:
        probe = subprocess.run([str(time_bin), "--version"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
    except (OSError, subprocess.SubprocessError):
        return []
    if probe.returncode != 0:
        return []
    time_log_path.parent.mkdir(parents=True, exist_ok=True)
    return [str(time_bin), "-v", "-o", str(time_log_path)]


def artifact_for_backend(test: dict, backend: str) -> Path:
    by_backend = test.get("artifacts_by_backend", {})
    if backend in by_backend:
        return Path(by_backend[backend].get("bin", ""))
    if backend == "xiangshan":
        return Path(test.get("artifacts", {}).get("bin", ""))
    return Path("")


def resolve_repo_path(root: Path, path: Path | None) -> Path | None:
    if path is None:
        return None
    if path.is_absolute():
        return path
    return root / path


def default_difftest_ref_so(root: Path, requires_h_aware_ref: bool = False) -> Path:
    if requires_h_aware_ref and os.environ.get("GCBH_REF_SO"):
        return Path(os.environ["GCBH_REF_SO"])
    return root / "XiangShan" / "ready-to-run" / "riscv64-nemu-interpreter-so"


def resolve_difftest_ref_so(root: Path, requested: Path | None, requires_h_aware_ref: bool = False) -> Path:
    return resolve_repo_path(root, requested) or default_difftest_ref_so(root, requires_h_aware_ref)


def default_gcpt_restorer_candidates(root: Path) -> list[Path]:
    return [
        root / "NEMU" / "resource" / "gcpt_restore" / "build" / "gcpt.bin",
        root / "build" / "external" / "nemu-gem5-ref-linux-aarch64" / "resource" / "gcpt_restore" / "build" / "gcpt.bin",
    ]


def normalize_gcpt_restorer_path(root: Path, raw: str) -> tuple[str | None, str | None]:
    path = resolve_repo_path(root, Path(raw))
    if path is None:
        return None, "gcpt restorer path was not resolved"
    if path.is_dir():
        path = path / "build" / "gcpt.bin"
    if not path.exists():
        return str(path), "missing gcpt restorer"
    return str(path), None


def iso_now() -> str:
    return datetime.now(timezone.utc).isoformat()


def parse_host_seconds(stats_path: Path) -> float | None:
    if not stats_path.exists():
        return None
    for line in stats_path.read_text(encoding="utf-8", errors="replace").splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[0] == "hostSeconds":
            try:
                return float(parts[1])
            except ValueError:
                return None
    return None


def difftest_log_evidence(log_path: Path) -> dict:
    text = log_path.read_text(encoding="utf-8", errors="replace") if log_path.exists() else ""
    enabled_line = None
    disabled_line = None
    ref_attempt_line = None
    ref_load_error_line = None
    for line in text.splitlines():
        if enabled_line is None and "Difftest is enabled with ref so" in line:
            enabled_line = line.strip()
        if disabled_line is None and "Difftest is disabled" in line:
            disabled_line = line.strip()
        if ref_attempt_line is None and " for difftest" in line:
            ref_attempt_line = line.strip()
        if ref_load_error_line is None and "cannot open shared object file" in line:
            ref_load_error_line = line.strip()
    return {
        "enabled_marker": enabled_line,
        "disabled_marker": disabled_line,
        "ref_attempt": ref_attempt_line,
        "ref_load_error": ref_load_error_line,
        "enabled": enabled_line is not None,
        "disabled": disabled_line is not None,
    }


def gcpt_log_evidence(log_path: Path) -> dict:
    text = log_path.read_text(encoding="utf-8", errors="replace") if log_path.exists() else ""
    checkpoint_line = None
    restorer_line = None
    restorer_size_line = None
    simulation_entry_line = None
    restored_line = None
    maxinsts_line = None
    for line in text.splitlines():
        lowered = line.lower()
        if checkpoint_line is None and any(token in lowered for token in ("generic_rv_cpt", "generic-rv-cpt", "restore from gcpt", "zstd")):
            checkpoint_line = line.strip()
        if restorer_line is None and "restorer" in lowered and "command line:" not in lowered:
            restorer_line = line.strip()
        if restorer_size_line is None and "gcpt restore size" in lowered:
            restorer_size_line = line.strip()
        if simulation_entry_line is None and ("Entering event queue" in line or "Starting simulation" in line):
            simulation_entry_line = line.strip()
        if restored_line is None and "Restored from Xiangshan RISC-V Checkpoint" in line:
            restored_line = line.strip()
        if maxinsts_line is None and "max instruction count" in lowered:
            maxinsts_line = line.strip()
    return {
        "checkpoint_marker": checkpoint_line,
        "restorer_marker": restorer_line,
        "restorer_size_marker": restorer_size_line,
        "simulation_entry_marker": simulation_entry_line,
        "restored_marker": restored_line,
        "maxinsts_marker": maxinsts_line,
        "entered_simulation": simulation_entry_line is not None,
        "reached_maxinsts": maxinsts_line is not None,
    }


def terminate_process_group(process: subprocess.Popen, log) -> bool:
    killed = False
    try:
        os.killpg(process.pid, signal.SIGTERM)
        killed = True
        log.write("\nSent SIGTERM to gem5 process group\n")
    except ProcessLookupError:
        return killed
    try:
        process.wait(timeout=5)
        return killed
    except subprocess.TimeoutExpired:
        try:
            os.killpg(process.pid, signal.SIGKILL)
            log.write("Sent SIGKILL to gem5 process group\n")
            killed = True
        except ProcessLookupError:
            return killed
        process.wait(timeout=5)
        return killed


def test_matches(test: dict, filters: set[str]) -> bool:
    if not filters:
        return True
    names = {
        test.get("id", ""),
        test.get("name", ""),
        f"{test.get('suite', '')}/{test.get('name', '')}",
        f"{test.get('suite', '')}-p-{test.get('name', '')}",
    }
    return bool(names & filters)


def select_manifest_tests(manifest: dict, filters: set[str], suite: str | None, suite_source: Path, manifest_path: Path) -> list[dict]:
    tests = manifest.get("tests", [])
    suite_ids: set[str] | None = None
    if suite == SUPPORTED_SUITE_ID:
        suite_payload = build_supported_suite(suite_source, manifest_path)
        suite_ids = set(suite_payload["ids"])
    selected = []
    for test in tests:
        if suite_ids is not None and test.get("id") not in suite_ids:
            continue
        if not test_matches(test, filters):
            continue
        selected.append(test)
    return selected


def run_one(
    root: Path,
    test: dict,
    output_dir: Path,
    timeout: int,
    run_known_unsupported: bool,
    difftest_mode: str,
    difftest_ref_so: Path | None,
) -> dict:
    test_id = test["id"]
    backend = "gem5"
    difftest_enabled = difftest_mode == "enabled"
    resolved_ref_so = resolve_difftest_ref_so(root, difftest_ref_so) if difftest_enabled else None
    if test_id in KNOWN_UNSUPPORTED_ISA_TESTS and not run_known_unsupported:
        return {
            "id": test_id,
            "suite": test["suite"],
            "backend": backend,
            "status": "unsupported",
            "reason": KNOWN_UNSUPPORTED_ISA_TESTS[test_id],
            "needs": test.get("needs", []),
            "known_unsupported": True,
            "difftest_enabled": difftest_enabled,
            "difftest_ref_so": str(resolved_ref_so) if resolved_ref_so else None,
        }
    if difftest_enabled and (resolved_ref_so is None or not resolved_ref_so.exists()):
        return {
            "id": test_id,
            "suite": test["suite"],
            "backend": backend,
            "status": "blocked_missing_artifact",
            "reason": "missing difftest reference shared library",
            "difftest_enabled": True,
            "difftest_ref_so": str(resolved_ref_so) if resolved_ref_so else None,
            "timed_out": False,
            "killed": False,
            "timeout_seconds": timeout,
        }
    bin_path = artifact_for_backend(test, backend)
    if not bin_path.exists():
        return {
            "id": test_id,
            "suite": test["suite"],
            "backend": backend,
            "status": "blocked_missing_artifact",
            "reason": "missing gem5 backend bin artifact",
            "bin": str(bin_path),
            "difftest_enabled": difftest_enabled,
            "difftest_ref_so": str(resolved_ref_so) if resolved_ref_so else None,
        }
    gem5 = root / "GEM5" / "build" / "RISCV" / "gem5.opt"
    config = root / "GEM5" / "configs" / "example" / "kmhv3.py"
    if not gem5.exists() or not config.exists():
        return {
            "id": test_id,
            "suite": test["suite"],
            "status": "blocked_missing_artifact",
            "reason": "missing gem5 binary or kmhv3.py",
            "bin": str(bin_path),
            "difftest_enabled": difftest_enabled,
            "difftest_ref_so": str(resolved_ref_so) if resolved_ref_so else None,
        }
    outdir = output_dir / "m5out" / test_id
    log_path = output_dir / "logs" / f"{test_id}.log"
    log_path.parent.mkdir(parents=True, exist_ok=True)
    outdir.mkdir(parents=True, exist_ok=True)
    command = [
        str(gem5),
        "-d",
        str(outdir),
        str(config),
        "--mem-type",
        "DDR4_2400_8x8",
    ]
    if difftest_enabled:
        command.extend(["--enable-difftest", f"--difftest-ref-so={resolved_ref_so}"])
    else:
        command.append("--disable-difftest")
    command.extend(["--raw-cpt", f"--generic-rv-cpt={bin_path}"])
    start = time.monotonic()
    rc = None
    timed_out = False
    killed = False
    with log_path.open("w", encoding="utf-8") as log:
        log.write("$ " + " ".join(command) + "\n\n")
        try:
            process = subprocess.Popen(
                command,
                cwd=root,
                stdout=log,
                stderr=subprocess.STDOUT,
                start_new_session=True,
            )
            rc = process.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            log.write(f"\nTIMEOUT after {timeout}s\n")
            timed_out = True
            killed = terminate_process_group(process, log)
    status, reason = classify_log(log_path, rc, timed_out)
    evidence = difftest_log_evidence(log_path)
    if difftest_enabled and status == "pass" and not evidence["enabled"]:
        status = "fail"
        reason = "program reached pass exit marker but difftest enable marker is missing"
    stats = outdir / "stats.txt"
    return {
        "id": test_id,
        "suite": test["suite"],
        "backend": backend,
        "status": status,
        "reason": reason,
        "return_code": rc,
        "command": command,
        "bin": str(bin_path),
        "log_path": str(log_path),
        "stats_path": str(stats) if stats.exists() else None,
        "timed_out": timed_out,
        "killed": killed,
        "timeout_seconds": timeout,
        "difftest_enabled": difftest_enabled,
        "difftest_ref_so": str(resolved_ref_so) if resolved_ref_so else None,
        "difftest_log_evidence": evidence,
        "host_time": round(time.monotonic() - start, 3),
    }


def summarize(rows: list[dict]) -> dict:
    by_status = {status: 0 for status in STATUS_ENUM}
    by_suite: dict[str, dict[str, int]] = {}
    host_times = []
    for row in rows:
        status = row["status"]
        by_status[status] = by_status.get(status, 0) + 1
        suite = row.get("suite", "unknown")
        by_suite.setdefault(suite, {s: 0 for s in STATUS_ENUM})
        by_suite[suite][status] = by_suite[suite].get(status, 0) + 1
        if isinstance(row.get("host_time"), (int, float)):
            host_times.append(float(row["host_time"]))
    timing = {
        "count": len(host_times),
        "sum": round(sum(host_times), 3) if host_times else None,
        "min": round(min(host_times), 3) if host_times else None,
        "median": round(statistics.median(host_times), 3) if host_times else None,
        "average": round(sum(host_times) / len(host_times), 3) if host_times else None,
        "max": round(max(host_times), 3) if host_times else None,
    }
    return {"total": len(rows), "by_status": by_status, "by_suite": by_suite, "host_time": timing}


def select_spec2006_entries(manifest: dict, filters: set[str], canary: bool) -> list[dict]:
    entries = manifest.get("benchmarks", [])
    if canary:
        entries = [entry for entry in entries if entry.get("canary") or entry.get("id") == manifest.get("canary_id")]
    if not filters:
        return list(entries)
    selected = []
    for entry in entries:
        names = {
            str(entry.get("id", "")),
            str(entry.get("benchmark", "")),
            str(entry.get("workload", "")),
            f"{entry.get('benchmark', '')}/{entry.get('workload', '')}",
            f"{entry.get('workload', '')}-{entry.get('point', '')}",
        }
        if names & filters:
            selected.append(entry)
    return selected


def effective_gcpt_layout(entry: dict, detected: dict) -> str:
    detected_layout = str(detected.get("layout") or "unknown")
    if detected_layout != "unknown":
        return detected_layout
    return str(entry.get("gcpt_layout") or "unknown")


def requires_rvh_checkpoint(entry: dict, layout: str) -> bool:
    return layout == "embedded-rvh" or bool(entry.get("requires_rvh"))


def requires_h_aware_ref(entry: dict, layout: str) -> bool:
    return layout == "embedded-rvh" or bool(entry.get("requires_h_aware_ref"))


def resolve_gcpt_restorer(root: Path, entry: dict, requested: str, layout: str) -> tuple[str | None, str, str | None]:
    if layout == "embedded-rvh":
        if requested in {"auto", "none"}:
            return "None", "none", None
        return (
            None,
            requested,
            "checkpoint is embedded RVH/new-layout GCPT; use --gcpt-restorer none to avoid overwriting its embedded restorer",
        )
    raw = requested
    if requested == "auto":
        manifest_value = entry.get("gcpt_restorer")
        if manifest_value and manifest_value not in {"auto", "unknown"}:
            raw = str(manifest_value)
        else:
            env_value = os.environ.get("GCB_RESTORER")
            if env_value:
                raw = env_value
            else:
                for candidate in default_gcpt_restorer_candidates(root):
                    if candidate.exists():
                        return str(candidate), "auto", None
                return None, "auto", "missing gcpt restorer; set GCB_RESTORER, pass --gcpt-restorer <path>, or build NEMU/resource/gcpt_restore/build/gcpt.bin"
    if raw == "none":
        return "None", "none", None
    path, error = normalize_gcpt_restorer_path(root, raw)
    return path, raw, error


def run_spec2006_one(
    root: Path,
    entry: dict,
    output_dir: Path,
    timeout: int,
    difftest_mode: str,
    difftest_ref_so: Path | None,
    gcpt_restorer: str,
    maxinsts: int | None,
    dry_run: bool,
    run_mode: str,
    checkpoint_end_maxinsts: int,
) -> dict:
    entry_id = entry["id"]
    difftest_enabled = difftest_mode == "enabled"
    checkpoint = resolve_repo_path(root, Path(entry["checkpoint"]))
    timeout_seconds = timeout or int(entry.get("timeout_seconds") or 300)
    if run_mode == "complete":
        maxinsts_value = maxinsts if maxinsts and maxinsts > 0 else int(entry.get("checkpoint_end_maxinsts") or checkpoint_end_maxinsts)
        maxinsts_policy = "checkpoint_end"
    else:
        maxinsts_value = maxinsts or int(entry.get("maxinsts") or 10000)
        maxinsts_policy = "bounded_canary"
    maxinsts_disabled = maxinsts_value is None
    detected_layout = detect_gcpt_layout(checkpoint) if checkpoint and checkpoint.exists() else {"layout": "unknown"}
    gcpt_layout = effective_gcpt_layout(entry, detected_layout)
    rvh_checkpoint = requires_rvh_checkpoint(entry, gcpt_layout)
    h_aware_ref_required = requires_h_aware_ref(entry, gcpt_layout)
    resolved_ref_so = resolve_difftest_ref_so(root, difftest_ref_so, h_aware_ref_required) if difftest_enabled else None
    restorer_path, restorer_policy, restorer_error = resolve_gcpt_restorer(root, entry, gcpt_restorer, gcpt_layout)
    time_log_path = output_dir / "time" / f"{entry_id}.time"
    base = {
        "id": entry_id,
        "suite": "spec2006",
        "benchmark": entry.get("benchmark"),
        "workload": entry.get("workload"),
        "point": entry.get("point"),
        "backend": "gem5",
        "checkpoint": str(checkpoint) if checkpoint else None,
        "checkpoint_metadata": entry,
        "difftest_enabled": difftest_enabled,
        "difftest_ref_so": str(resolved_ref_so) if resolved_ref_so else None,
        "gcpt_restorer": restorer_path,
        "gcpt_restorer_policy": restorer_policy,
        "gcpt_layout": gcpt_layout,
        "gcpt_layout_evidence": detected_layout,
        "requires_rvh": rvh_checkpoint,
        "requires_h_aware_ref": h_aware_ref_required,
        "maxinsts": maxinsts_value,
        "maxinsts_disabled": maxinsts_disabled,
        "maxinsts_policy": maxinsts_policy,
        "run_mode": run_mode,
        "completion_policy": "checkpoint_end_maxinsts" if run_mode == "complete" else "bounded_canary_after_checkpoint_entry",
        "complete_run_stop_condition": (
            "pass when checkpoint enters simulation and reaches the checkpoint-end maxinsts boundary"
            if run_mode == "complete"
            else "pass when checkpoint enters simulation and reaches maxinsts or bounded timeout"
        ),
        "timeout_seconds": timeout_seconds,
        "started_at": None,
        "ended_at": None,
        "wall_time_seconds": None,
        "host_time": None,
        "timed_out": False,
        "killed": False,
        "oom_detected": False,
        "oom_reason": None,
        "time_log_path": str(time_log_path),
        "dry_run": dry_run,
    }
    if checkpoint is None or not checkpoint.exists():
        return {**base, "status": "blocked_missing_artifact", "reason": "missing SPEC2006 checkpoint"}
    if difftest_enabled and (resolved_ref_so is None or not resolved_ref_so.exists()):
        return {**base, "status": "blocked_missing_artifact", "reason": "missing difftest reference shared library"}
    if difftest_enabled and h_aware_ref_required and difftest_ref_so is None and not os.environ.get("GCBH_REF_SO"):
        return {
            **base,
            "status": "blocked_missing_artifact",
            "reason": "embedded RVH checkpoint requires an H-aware difftest ref; pass --difftest-ref-so or set GCBH_REF_SO",
        }
    if restorer_error:
        return {**base, "status": "blocked_missing_artifact", "reason": restorer_error}
    gem5 = root / "GEM5" / "build" / "RISCV" / "gem5.opt"
    config = root / "GEM5" / "configs" / "example" / "kmhv3.py"
    if not gem5.exists() or not config.exists():
        return {**base, "status": "blocked_missing_artifact", "reason": "missing gem5 binary or kmhv3.py", "gem5": str(gem5), "config": str(config)}
    outdir = output_dir / "m5out" / entry_id
    log_path = output_dir / "logs" / f"{entry_id}.log"
    stats_path = outdir / "stats.txt"
    command = [
        str(gem5),
        "-d",
        str(outdir),
        str(config),
        "--mem-type",
        "DDR4_2400_8x8",
    ]
    if difftest_enabled:
        command.extend(["--enable-difftest", f"--difftest-ref-so={resolved_ref_so}"])
    else:
        command.append("--disable-difftest")
    if rvh_checkpoint:
        command.extend(["--restore-rvh-cpt", "--enable-h-gcpt"])
    command.extend([f"--generic-rv-cpt={checkpoint}", f"--gcpt-restorer={restorer_path}"])
    if maxinsts_value is not None:
        command.append(f"--maxinsts={maxinsts_value}")
    if dry_run:
        return {
            **base,
            "status": "unsupported",
            "reason": "dry-run only",
            "command": command,
            "executed_command": command,
            "log_path": str(log_path),
            "stats_path": str(stats_path),
            "time_log_path": str(time_log_path),
            "oom_detected": False,
            "oom_reason": None,
        }
    log_path.parent.mkdir(parents=True, exist_ok=True)
    outdir.mkdir(parents=True, exist_ok=True)
    time_prefix = gnu_time_prefix(time_log_path)
    executed_command = [*time_prefix, *command]
    started_at = iso_now()
    start = time.monotonic()
    rc = None
    timed_out = False
    killed = False
    with log_path.open("w", encoding="utf-8") as log:
        log.write("$ " + " ".join(executed_command) + "\n\n")
        try:
            process = subprocess.Popen(executed_command, cwd=root, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
            rc = process.wait(timeout=timeout_seconds)
        except subprocess.TimeoutExpired:
            log.write(f"\nTIMEOUT after {timeout_seconds}s\n")
            timed_out = True
            killed = terminate_process_group(process, log)
    ended_at = iso_now()
    wall_time = round(time.monotonic() - start, 3)
    status, reason = classify_log(log_path, rc, timed_out)
    difftest_evidence = difftest_log_evidence(log_path)
    gcpt_evidence = gcpt_log_evidence(log_path)
    oom_evidence = oom_log_evidence(log_path, rc, timed_out, killed, time_log_path if time_log_path.exists() else None)
    if oom_evidence["detected"]:
        status = "oom"
        reason = oom_evidence["reason"] or "OOM evidence detected"
    if status == "timeout" and gcpt_evidence["entered_simulation"] and run_mode == "complete":
        reason = "entered checkpoint simulation but did not reach checkpoint-end boundary before long timeout"
    elif status == "timeout" and gcpt_evidence["entered_simulation"]:
        reason = "entered checkpoint simulation and reached bounded timeout"
    elif status == "timeout":
        status = "fail"
        reason = "timed out before checkpoint simulation entry"
    if run_mode == "complete" and status == "unsupported" and gcpt_evidence["entered_simulation"] and gcpt_evidence["reached_maxinsts"]:
        status = "pass"
        reason = "checkpoint-end max instruction count reached after checkpoint entry"
    elif run_mode == "complete" and status == "unsupported" and gcpt_evidence["entered_simulation"]:
        status = "fail"
        reason = "gem5 exited after checkpoint entry without a complete-run marker"
    elif status == "unsupported" and gcpt_evidence["entered_simulation"] and gcpt_evidence["reached_maxinsts"]:
        status = "pass"
        reason = "entered checkpoint simulation and reached max instruction count"
    if run_mode == "complete" and status == "pass" and not gcpt_evidence["entered_simulation"]:
        status = "fail"
        reason = "complete-run marker appeared before checkpoint simulation entry"
    if difftest_enabled and status in {"pass", "timeout", "unsupported"} and not difftest_evidence["enabled"]:
        status = "fail"
        reason = "checkpoint run did not emit difftest enable marker"
    host_seconds = parse_host_seconds(stats_path)
    return {
        **base,
        "status": status,
        "reason": reason,
        "return_code": rc,
        "command": command,
        "executed_command": executed_command,
        "log_path": str(log_path),
        "stats_path": str(stats_path) if stats_path.exists() else None,
        "time_log_path": str(time_log_path) if time_log_path.exists() else str(time_log_path),
        "started_at": started_at,
        "ended_at": ended_at,
        "wall_time_seconds": wall_time,
        "host_time": wall_time,
        "gem5_host_seconds": host_seconds,
        "timed_out": timed_out,
        "killed": killed,
        "stop_reason": reason,
        "oom_detected": oom_evidence["detected"],
        "oom_reason": oom_evidence["reason"],
        "oom_log_evidence": oom_evidence,
        "difftest_log_evidence": difftest_evidence,
        "gcpt_log_evidence": gcpt_evidence,
    }


def reuse_existing_rows(source: Path, tests: list[dict]) -> list[dict]:
    source_payload = load_manifest(source)
    source_by_id = {row.get("id"): row for row in source_payload.get("results", []) if row.get("id")}
    rows = []
    for test in tests:
        test_id = test["id"]
        source_row = source_by_id.get(test_id)
        if source_row is None:
            rows.append(
                {
                    "id": test_id,
                    "suite": test["suite"],
                    "backend": "gem5",
                    "status": "blocked_missing_artifact",
                    "reason": "selected test is missing from reusable GEM5 detail source",
                    "reused_from": str(source),
                }
            )
            continue
        row = dict(source_row)
        row["reused_from"] = str(source)
        rows.append(row)
    return rows


def write_payload(output: Path, payload: dict) -> None:
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    print(json.dumps(payload["summary"], indent=2, sort_keys=True))
    print(f"results={output}")
    print(f"VALIDATION_STATUS={payload['status']}")
    print(f"VALIDATION_REASON={payload['reason']}")


def run_isa(args: argparse.Namespace) -> int:
    root = args.repo_root.resolve()
    manifest = load_manifest(args.manifest)
    filters = set(args.test)
    tests = select_manifest_tests(manifest, filters, args.suite, args.suite_source, args.manifest)
    if not tests:
        payload = {
            "schema_version": 1,
            "layer": "l3",
            "target": "gem5-isa-first-layer",
            "stage": "isa",
            "status": "blocked_missing_artifact",
            "reason": "no manifest entries matched requested tests",
            "summary": {"total": 0, "by_status": {}, "by_suite": {}},
            "results": [],
        }
        write_payload(args.output, payload)
        return 1
    if args.reuse_existing:
        rows = reuse_existing_rows(args.suite_source, tests)
    else:
        rows = []
        for test in tests:
            rows.append(
                run_one(
                    root,
                    test,
                    args.output.parent,
                    args.per_test_timeout,
                    args.run_known_unsupported,
                    args.difftest_mode,
                    args.difftest_ref_so,
                )
            )
    summary = summarize(rows)
    blocking = sum(summary["by_status"].get(status, 0) for status in ("fail", "timeout", "blocked_missing_artifact", "blocked_env"))
    all_supported_pass = blocking == 0
    supported_pass = summary["by_status"].get("pass", 0)
    unsupported = summary["by_status"].get("unsupported", 0)
    if not all_supported_pass:
        status = "fail"
        reason = "simple ISA gate did not fully pass; heavier gates must not run"
    elif supported_pass:
        status = "pass"
        reason = "all supported manifest entries passed" if not unsupported else "all supported manifest entries passed; known unsupported entries were explicitly skipped"
    else:
        status = "unsupported"
        reason = "all selected manifest entries are known unsupported by this GEM5 raw-cpt ISA gate"
    payload = {
        "schema_version": 1,
        "layer": "l3",
        "target": "gem5-isa-first-layer",
        "stage": "isa",
        "suite": args.suite,
        "suite_source": str(args.suite_source) if args.suite else None,
        "difftest": {
            "mode": args.difftest_mode,
            "enabled": args.difftest_mode == "enabled",
            "ref_so": str(resolve_difftest_ref_so(root, args.difftest_ref_so)) if args.difftest_mode == "enabled" else None,
        },
        "status": status,
        "reason": reason,
        "summary": summary,
        "results": rows,
    }
    write_payload(args.output, payload)
    return 0 if status in {"pass", "unsupported"} else 1


def run_blocked_stage(args: argparse.Namespace, stage: str) -> int:
    if stage == "medium":
        reason = "GEM5 medium workload manifest is not provided"
        status = "blocked_missing_artifact"
    else:
        reason = "SPEC2006 checkpoint manifest is not provided"
        status = "blocked_missing_artifact"
    payload = {
        "schema_version": 1,
        "layer": "l3",
        "target": f"gem5-{stage}",
        "stage": stage,
        "status": status,
        "reason": reason,
        "summary": {"total": 1, "by_status": {status: 1}, "by_suite": {}},
        "results": [{"id": stage, "status": status, "reason": reason}],
    }
    if stage == "medium":
        payload["missing_artifact"] = {
            "kind": "GEM5 medium workload manifest",
            "recommended_path": MEDIUM_MANIFEST_RECOMMENDED_PATH,
            "expected_workloads": ["coremark", "dhrystone", "microbench"],
        }
        payload["results"][0]["missing_artifact"] = payload["missing_artifact"]
    elif stage == "spec2006":
        payload["missing_artifact"] = {
            "kind": "SPEC2006 checkpoint manifest",
            "recommended_path": SPEC2006_MANIFEST_RECOMMENDED_PATH,
        }
        payload["manifest_contract"] = SPEC2006_MANIFEST_CONTRACT
        payload["results"][0]["missing_artifact"] = payload["missing_artifact"]
    write_payload(args.output, payload)
    return 0


def spec2006_target(run_mode: str, difftest_mode: str) -> str:
    if run_mode != "complete":
        return "gem5-spec2006-checkpoint"
    if difftest_mode == "enabled":
        return "gem5-spec2006-full-difftest"
    return "gem5-spec2006-full-disabled"


def run_spec2006(args: argparse.Namespace) -> int:
    root = args.repo_root.resolve()
    if not args.manifest.exists():
        return run_blocked_stage(args, "spec2006")
    manifest = load_manifest(args.manifest)
    entries = select_spec2006_entries(manifest, set(args.test), args.spec2006_canary)
    if not entries:
        target = spec2006_target(args.spec2006_run_mode, args.difftest_mode)
        payload = {
            "schema_version": 1,
            "layer": "l3",
            "target": target,
            "stage": "spec2006",
            "run_mode": args.spec2006_run_mode,
            "status": "blocked_missing_artifact",
            "reason": "no SPEC2006 checkpoint manifest entries matched requested filters",
            "summary": {"total": 0, "by_status": {}, "by_suite": {}},
            "results": [],
            "manifest": str(args.manifest),
        }
        write_payload(args.output, payload)
        return 1
    rows = []
    for entry in entries:
        row = run_spec2006_one(
            root,
            entry,
            args.output.parent,
            args.per_test_timeout,
            args.difftest_mode,
            args.difftest_ref_so,
            args.gcpt_restorer,
            args.maxinsts,
            args.dry_run,
            args.spec2006_run_mode,
            args.spec2006_checkpoint_end_maxinsts,
        )
        rows.append(row)
        if row.get("status") == "oom":
            break
    summary = summarize(rows)
    hard_statuses = ("fail", "blocked_missing_artifact", "blocked_env", "timeout", "oom") if args.spec2006_run_mode == "complete" else ("fail", "blocked_missing_artifact", "blocked_env", "oom")
    hard_blocking = sum(summary["by_status"].get(status, 0) for status in hard_statuses)
    blocking = hard_blocking + summary["by_status"].get("unsupported", 0)
    if args.dry_run and hard_blocking:
        if summary["by_status"].get("blocked_missing_artifact", 0):
            status = "blocked_missing_artifact"
            reason = "dry-run input validation found missing artifacts"
        elif summary["by_status"].get("blocked_env", 0):
            status = "blocked_env"
            reason = "dry-run input validation found environment blockers"
        else:
            status = "fail"
            reason = "dry-run input validation failed"
    elif args.dry_run:
        status = "unsupported"
        reason = "dry-run only"
    else:
        if blocking == 0 and rows:
            status = "pass"
            reason = (
                "all selected SPEC2006 checkpoint entries reached checkpoint-end exit criteria"
                if args.spec2006_run_mode == "complete"
                else "all selected SPEC2006 checkpoint entries reached bounded canary criteria"
            )
        elif summary["by_status"].get("oom", 0):
            status = "oom"
            reason = "selected SPEC2006 checkpoint entries encountered OOM evidence; stop subsequent phases"
        elif args.spec2006_run_mode == "complete" and summary["by_status"].get("timeout", 0) and not summary["by_status"].get("fail", 0):
            status = "timeout"
            reason = "selected SPEC2006 checkpoint entries did not reach checkpoint-end boundary before long timeout"
        elif summary["by_status"].get("blocked_missing_artifact", 0) and not summary["by_status"].get("fail", 0) and not summary["by_status"].get("blocked_env", 0):
            status = "blocked_missing_artifact"
            reason = "selected SPEC2006 checkpoint entries are blocked by missing artifacts"
        elif summary["by_status"].get("blocked_env", 0) and not summary["by_status"].get("fail", 0):
            status = "blocked_env"
            reason = "selected SPEC2006 checkpoint entries are blocked by execution environment"
        else:
            status = "fail"
            reason = "selected SPEC2006 checkpoint entries did not satisfy canary criteria"
    target = spec2006_target(args.spec2006_run_mode, args.difftest_mode)
    payload = {
        "schema_version": 1,
        "layer": "l3",
        "target": target,
        "stage": "spec2006",
        "run_mode": args.spec2006_run_mode,
        "status": status,
        "reason": reason,
        "manifest": str(args.manifest),
        "canary_id": manifest.get("canary_id"),
        "difftest": {
            "mode": args.difftest_mode,
            "enabled": args.difftest_mode == "enabled",
            "ref_so": str(resolve_difftest_ref_so(root, args.difftest_ref_so)) if args.difftest_mode == "enabled" else None,
        },
        "summary": summary,
        "results": rows,
    }
    write_payload(args.output, payload)
    return 0 if status in {"pass", "unsupported"} else 1


def main(argv: list[str]) -> int:
    root = repo_root()
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--stage", choices=("isa", "medium", "spec2006"), required=True)
    parser.add_argument("--manifest", type=Path, default=root / "baremetal" / "riscv-tests" / "isa" / "build" / "manifest.json")
    parser.add_argument("--output", type=Path, default=None)
    parser.add_argument("--repo-root", type=Path, default=root)
    parser.add_argument("--per-test-timeout", type=int, default=5)
    parser.add_argument("--test", action="append", default=[], help="test filter: name, suite/name, or manifest id")
    parser.add_argument("--suite", choices=(SUPPORTED_SUITE_ID,), default=None, help="shared test suite to select before --test filtering")
    parser.add_argument(
        "--suite-source",
        type=Path,
        default=root / "build" / "validation" / "l3-gem5" / "isa" / "results.json",
        help="GEM5 ISA result JSON used to derive supported-cross-77",
    )
    parser.add_argument("--reuse-existing", action="store_true", help="validate selected tests against --suite-source instead of running GEM5")
    parser.add_argument("--run-known-unsupported", action="store_true", help="execute tests that are otherwise classified as known unsupported")
    parser.add_argument("--difftest-mode", choices=("disabled", "enabled"), default="disabled", help="run GEM5 with difftest disabled or enabled")
    parser.add_argument("--difftest-ref-so", type=Path, default=None, help="reference model shared library for --difftest-mode enabled; defaults to XiangShan/ready-to-run/riscv64-nemu-interpreter-so")
    parser.add_argument("--dry-run", action="store_true", help="emit selected commands without launching GEM5")
    parser.add_argument("--spec2006-canary", action="store_true", help="select the manifest canary entry for --stage spec2006")
    parser.add_argument("--spec2006-run-mode", choices=("bounded", "complete"), default="bounded", help="bounded keeps canary maxinsts semantics; complete runs until the checkpoint-end instruction boundary")
    parser.add_argument("--spec2006-checkpoint-end-maxinsts", type=int, default=SPEC2006_DEFAULT_CHECKPOINT_END_MAXINSTS, help="complete-mode instruction boundary that marks the end of the checkpoint sample")
    parser.add_argument("--gcpt-restorer", default="auto", help="GCPT restorer policy for SPEC2006: auto, none, or a path")
    parser.add_argument("--maxinsts", type=int, default=None, help="override instruction limit; bounded defaults to manifest maxinsts, complete defaults to --spec2006-checkpoint-end-maxinsts")
    args = parser.parse_args(argv)
    if args.output is None:
        if args.difftest_mode == "enabled" and args.stage == "isa":
            output_leaf = args.suite or args.stage
            args.output = root / "build" / "validation" / "l3-gem5-enable-difftest" / output_leaf / "results.json"
        elif args.stage == "spec2006" and args.spec2006_run_mode == "complete":
            output_leaf = "spec2006-full-difftest" if args.difftest_mode == "enabled" else "spec2006-full-disabled"
            args.output = root / "build" / "validation" / "l3-gem5" / output_leaf / "results.json"
        else:
            args.output = root / "build" / "validation" / "l3-gem5" / args.stage / "results.json"
    if args.stage == "isa":
        return run_isa(args)
    if args.stage == "spec2006":
        return run_spec2006(args)
    return run_blocked_stage(args, args.stage)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
