def repo_root() -> Path:
    return Path(__file__).resolve().parents[2]


def load_json(path: Path) -> dict[str, Any] | None:
    if not path.exists():
        return None
    return json.loads(path.read_text(encoding="utf-8"))


def summarize_statuses(rows: list[dict[str, Any]]) -> dict[str, int]:
    counts = Counter(row.get("effective_status", row.get("status", "missing")) for row in rows)
    return {status: counts.get(status, 0) for status in (*STATUS_ENUM, "missing")}


def flatten_harness_results(root: Path) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    seen_targets = set()
    for rel in HARNESS_RESULT_PATHS:
        payload = load_json(root / rel)
        if payload is None:
            continue
        for result in payload.get("results", []):
            target = result.get("target")
            if target in seen_targets:
                continue
            seen_targets.add(target)
            rows.append(
                {
                    "source": rel,
                    "layer": result.get("layer"),
                    "target": target,
                    "workload": result.get("workload"),
                    "host": result.get("host"),
                    "status": result.get("status"),
                    "return_code": result.get("return_code"),
                    "exit_reason": result.get("exit_reason"),
                    "log_path": result.get("log_path"),
                    "stats_path": result.get("stats_path"),
                    "simInsts": result.get("simInsts"),
                    "instrCnt": result.get("instrCnt"),
                    "cycles": result.get("cycles"),
                    "IPC": result.get("IPC"),
                    "host_time": result.get("host_time"),
                }
            )
    return rows


def detail_gate_rows(details: dict[str, Any], existing_targets: set[str]) -> list[dict[str, Any]]:
    gem5_l3 = gem5_l3_isa_detail(details)
    wally_l3 = details.get("wally_l3_isa", {})
    xiangshan_l3 = xiangshan_l3_detail(details)
    specs = (
        ("gem5_l3", "l3", "gem5-isa-first-layer", "linux", "supported-cross-77 RV64 suite"),
        ("gem5_l3_difftest_eda00", "l3", "gem5-isa-difftest-eda00", "eda-00", "supported-cross-77 RV64 suite with enable-difftest"),
        (
            "gem5_l3_difftest_linux_aarch64_spike",
            "l3",
            "gem5-isa-difftest-linux-aarch64-spike",
            "linux-aarch64",
            "supported-cross-77 RV64 suite with Spike enable-difftest",
        ),
        (
            "gem5_l3_difftest_linux_aarch64_nemu",
            "l3",
            "gem5-isa-difftest-linux-aarch64-nemu",
            "linux-aarch64",
            "supported-cross-77 RV64 suite with NEMU enable-difftest",
        ),
        ("wally_l3_isa", "l3", "wally-verilator-isa", "linux", "supported-cross-77 RV64 suite"),
        ("gem5_l3_medium", "l3", "gem5-medium", "linux", "CoreMark/Dhrystone/microbench"),
        ("gem5_l3_spec2006", "l3", "spec2006-checkpoint", "linux/eda-00", "SPEC2006 checkpoint manifest"),
        ("xiangshan_l3", "l3", "xiangshan-emu-isa", "eda-00", "supported-cross-77 RV64 suite"),
    )
    rows = []
    for key, layer, target, host, workload in specs:
        if target in existing_targets:
            continue
        if key == "gem5_l3":
            payload = gem5_l3
            source = (
                DETAIL_RESULT_PATHS["gem5_l3_supported_suite"]
                if details.get("gem5_l3_supported_suite", {}).get("status") not in {None, "missing"}
                else DETAIL_RESULT_PATHS["gem5_l3_isa"]
            )
        elif key == "wally_l3_isa":
            payload = wally_l3
            source = DETAIL_RESULT_PATHS["wally_l3_isa"]
        elif key == "xiangshan_l3":
            payload = xiangshan_l3
            source = (
                DETAIL_RESULT_PATHS["xiangshan_l3_isa"]
                if details.get("xiangshan_l3_isa", {}).get("status") not in {None, "missing"}
                else DETAIL_RESULT_PATHS["xiangshan_l3_eda00_smoke"]
                if details.get("xiangshan_l3_eda00_smoke", {}).get("status") not in {None, "missing"}
                else DETAIL_RESULT_PATHS["xiangshan_l3_local_blocker"]
            )
        else:
            payload = details.get(key, {})
            source = DETAIL_RESULT_PATHS[key]
        status = payload.get("status")
        if status in {None, "missing"}:
            continue
        rows.append(
            {
                "source": source,
                "layer": layer,
                "target": target,
                "workload": workload,
                "host": host,
                "status": status,
                "return_code": None,
                "exit_reason": payload.get("reason"),
                "log_path": payload.get("path"),
                "stats_path": None,
                "simInsts": None,
                "instrCnt": None,
                "cycles": None,
                "IPC": None,
                "host_time": None,
            }
        )
    return rows


def load_details(root: Path) -> dict[str, Any]:
    details: dict[str, Any] = {}
    for name, rel in DETAIL_RESULT_PATHS.items():
        details[name] = load_json(root / rel) or {"status": "missing", "path": rel}
    return details


def xiangshan_l3_detail(details: dict[str, Any]) -> dict[str, Any]:
    complete_suite = details.get("xiangshan_l3_isa", {})
    if complete_suite.get("status") not in {None, "missing"}:
        return complete_suite
    eda00_smoke = details.get("xiangshan_l3_eda00_smoke", {})
    if eda00_smoke.get("status") not in {None, "missing"}:
        return eda00_smoke
    return details.get("xiangshan_l3_local_blocker", {})


def gem5_l3_isa_detail(details: dict[str, Any]) -> dict[str, Any]:
    supported_suite = details.get("gem5_l3_supported_suite", {})
    if supported_suite.get("status") not in {None, "missing"}:
        return supported_suite
    return details.get("gem5_l3_isa", {})


def normalize_status(status: Any) -> str | None:
    if status is None:
        return None
    if status == "direct_run":
        return "pass"
    if status in {"needs_wally_harness_support", "needs_test_adaptation", "target_unsupported"}:
        return "unsupported"
    if status in STATUS_ENUM or status == "missing":
        return str(status)
    return "fail"


def detail_status_for(row: dict[str, Any], details: dict[str, Any]) -> str | None:
    target = row.get("target")
    if target == "wally-benchmark":
        return details.get("wally_benchmark", {}).get("benchmark", {}).get("status")
    if target == "wally-isa-matrix":
        return details.get("wally_isa_matrix", {}).get("status")
    if target == "wally-verilator-isa":
        return details.get("wally_l3_isa", {}).get("status")
    if target == "wally-prepare":
        return details.get("wally_prepare", {}).get("status")
    if target == "gem5-bpu-unit":
        return details.get("gem5_bpu", {}).get("status")
    if target == "xiangshan-bpu-schema":
        return details.get("bpu_trace_schema", {}).get("status")
    if target == "xiangshan-linux-compile":
        return details.get("xiangshan_compile", {}).get("status")
    if target == "xiangshan-linux-bpu-scalatest":
        return details.get("xiangshan_bpu_scalatest", {}).get("status")
    if target == "gem5-isa-first-layer":
        return gem5_l3_isa_detail(details).get("status")
    if target == "gem5-isa-difftest-eda00":
        return details.get("gem5_l3_difftest_eda00", {}).get("status")
    if target == "gem5-isa-difftest-linux-aarch64-spike":
        return details.get("gem5_l3_difftest_linux_aarch64_spike", {}).get("status")
    if target == "gem5-isa-difftest-linux-aarch64-nemu":
        return details.get("gem5_l3_difftest_linux_aarch64_nemu", {}).get("status")
    if target == "gem5-medium":
        return details.get("gem5_l3_medium", {}).get("status")
    if target == "spec2006-checkpoint":
        return details.get("gem5_l3_spec2006", {}).get("status")
    if target == "xiangshan-emu-isa":
        return xiangshan_l3_detail(details).get("status")
    return None


def apply_effective_statuses(gates: list[dict[str, Any]], details: dict[str, Any]) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    normalized_rows = []
    inconsistent = []
    for row in gates:
        new_row = dict(row)
        harness_status = normalize_status(row.get("status"))
        detail_status = detail_status_for(row, details)
        effective_status = normalize_status(detail_status) or harness_status or "missing"
        new_row["harness_status"] = harness_status
        new_row["detail_status"] = detail_status
        new_row["effective_status"] = effective_status
        new_row["status"] = effective_status
        if detail_status is not None and harness_status != effective_status:
            inconsistent.append(
                {
                    "source": row.get("source"),
                    "target": row.get("target"),
                    "harness_status": harness_status,
                    "detail_status": detail_status,
                    "effective_status": effective_status,
                    "reason": "harness top-level status conflicts with detail status",
                }
            )
        normalized_rows.append(new_row)
    return normalized_rows, inconsistent


def run_time_summary(gates: list[dict[str, Any]]) -> dict[str, Any]:
    rows = []
    for row in gates:
        if row.get("host_time") is not None:
            rows.append(
                {
                    "target": row.get("target"),
                    "host": row.get("host"),
                    "status": row.get("effective_status", row.get("status")),
                    "host_time": row.get("host_time"),
                }
            )
    total_host_time = sum(row["host_time"] for row in rows if isinstance(row.get("host_time"), (int, float)))
    return {"rows": rows, "total_host_time": round(total_host_time, 3)}


def performance_summary(gates: list[dict[str, Any]], details: dict[str, Any]) -> dict[str, Any]:
    metric_names = ("simInsts", "instrCnt", "cycles", "IPC")
    valid_rows = []
    debug_artifacts = []
    for row in gates:
        metrics = {name: row.get(name) for name in metric_names}
        status = row.get("effective_status", row.get("status"))
        if status == "pass" and all(metrics[name] is not None for name in metric_names):
            valid_rows.append({"target": row.get("target"), "host": row.get("host"), **metrics, "stats_path": row.get("stats_path")})
        elif row.get("stats_path"):
            debug_artifacts.append(
                {
                    "target": row.get("target"),
                    "host": row.get("host"),
                    "status": status,
                    "stats_path": row.get("stats_path"),
                    "reason": "stats_path is debug-only because workload did not provide a full pass+metrics performance sample",
                }
            )
    for target, detail_payload in (
        ("gem5-isa-first-layer", gem5_l3_isa_detail(details)),
        ("gem5-isa-difftest-eda00", details.get("gem5_l3_difftest_eda00", {})),
        (
            "gem5-isa-difftest-linux-aarch64-spike",
            details.get("gem5_l3_difftest_linux_aarch64_spike", {}),
        ),
        (
            "gem5-isa-difftest-linux-aarch64-nemu",
            details.get("gem5_l3_difftest_linux_aarch64_nemu", {}),
        ),
    ):
        for row in detail_payload.get("results", []):
            if row.get("stats_path") and row.get("status") != "pass":
                debug_artifacts.append(
                    {
                        "target": target,
                        "workload": row.get("id"),
                        "status": row.get("status"),
                        "stats_path": row.get("stats_path"),
                        "reason": "GEM5 stats from non-pass workload are retained only as debug artifacts",
                    }
                )
    invalid_reasons = []
    if not valid_rows:
        invalid_reasons.append("no correctness-pass workload exposes simInsts/instrCnt/cycles/IPC")
    return {
        "performance_valid": bool(valid_rows),
        "valid_rows": valid_rows,
        "debug_artifacts": debug_artifacts,
        "invalid_reason": "; ".join(invalid_reasons) if invalid_reasons else None,
        "note": "host_time is reported in run_time_summary; performance_summary only contains DUT performance metrics from correctness-pass workloads",
    }


def build_summary(root: Path) -> dict[str, Any]:
    details = load_details(root)
    raw_gates = flatten_harness_results(root)
    raw_gates.extend(detail_gate_rows(details, {row.get("target") for row in raw_gates}))
    gates, inconsistent_statuses = apply_effective_statuses(raw_gates, details)
    manifest_summary = details.get("manifest", {}).get("summary", {})
    wally_matrix = details.get("wally_isa_matrix", {}).get("matrix", {}).get("summary", {})
    wally_benchmark = details.get("wally_benchmark", {}).get("benchmark", {})
    wally_l3_isa = details.get("wally_l3_isa", {})
    gem5_l3_isa = gem5_l3_isa_detail(details)
    xiangshan_l3 = xiangshan_l3_detail(details)
    payload = {
        "schema_version": 1,
        "status_enum": STATUS_ENUM,
        "manifest_summary": manifest_summary,
        "gate_summary": summarize_statuses(gates),
        "gates": gates,
        "inconsistent_statuses": inconsistent_statuses,
        "detail_summary": {
            "gem5_bpu_status": details.get("gem5_bpu", {}).get("status"),
            "bpu_trace_schema_status": details.get("bpu_trace_schema", {}).get("status"),
            "xiangshan_linux_compile_status": details.get("xiangshan_compile", {}).get("status"),
            "xiangshan_linux_bpu_scalatest_status": details.get("xiangshan_bpu_scalatest", {}).get("status"),
            "wally_prepare_status": details.get("wally_prepare", {}).get("status"),
            "wally_matrix_summary": wally_matrix,
            "wally_benchmark_status": wally_benchmark.get("status"),
            "wally_l3_isa_status": wally_l3_isa.get("status"),
            "wally_l3_isa_summary": wally_l3_isa.get("summary"),
            "gem5_l3_isa_status": gem5_l3_isa.get("status"),
            "gem5_l3_isa_summary": gem5_l3_isa.get("summary"),
            "gem5_l3_isa_source": (
                DETAIL_RESULT_PATHS["gem5_l3_supported_suite"]
                if details.get("gem5_l3_supported_suite", {}).get("status") not in {None, "missing"}
                else DETAIL_RESULT_PATHS["gem5_l3_isa"]
            ),
            "gem5_l3_difftest_eda00_status": details.get("gem5_l3_difftest_eda00", {}).get("status"),
            "gem5_l3_difftest_eda00_summary": details.get("gem5_l3_difftest_eda00", {}).get("summary"),
            "gem5_l3_difftest_eda00_source": DETAIL_RESULT_PATHS["gem5_l3_difftest_eda00"],
            "gem5_l3_difftest_linux_aarch64_spike_status": details.get("gem5_l3_difftest_linux_aarch64_spike", {}).get("status"),
            "gem5_l3_difftest_linux_aarch64_spike_summary": details.get("gem5_l3_difftest_linux_aarch64_spike", {}).get("summary"),
            "gem5_l3_difftest_linux_aarch64_spike_source": DETAIL_RESULT_PATHS["gem5_l3_difftest_linux_aarch64_spike"],
            "gem5_l3_difftest_linux_aarch64_nemu_status": details.get("gem5_l3_difftest_linux_aarch64_nemu", {}).get("status"),
            "gem5_l3_difftest_linux_aarch64_nemu_summary": details.get("gem5_l3_difftest_linux_aarch64_nemu", {}).get("summary"),
            "gem5_l3_difftest_linux_aarch64_nemu_source": DETAIL_RESULT_PATHS["gem5_l3_difftest_linux_aarch64_nemu"],
            "gem5_l3_medium_status": details.get("gem5_l3_medium", {}).get("status"),
            "gem5_l3_medium_missing_artifact": details.get("gem5_l3_medium", {}).get("missing_artifact"),
            "gem5_l3_spec2006_status": details.get("gem5_l3_spec2006", {}).get("status"),
            "gem5_l3_spec2006_missing_artifact": details.get("gem5_l3_spec2006", {}).get("missing_artifact"),
            "gem5_l3_spec2006_manifest_contract": details.get("gem5_l3_spec2006", {}).get("manifest_contract"),
            "xiangshan_l3_status": xiangshan_l3.get("status"),
            "xiangshan_l3_reason": xiangshan_l3.get("reason"),
            "xiangshan_l3_summary": xiangshan_l3.get("summary"),
            "xiangshan_l3_source": (
                DETAIL_RESULT_PATHS["xiangshan_l3_isa"]
                if details.get("xiangshan_l3_isa", {}).get("status") not in {None, "missing"}
                else xiangshan_l3.get("source")
            ),
        },
        "run_time_summary": run_time_summary(gates),
        "performance_summary": performance_summary(gates, details),
    }
    return payload


def write_markdown(path: Path, payload: dict[str, Any]) -> None:
    lines = [
        "# Validation Evidence Summary",
        "",
        "## Gate Summary",
        "",
        "| status | count |",
        "|---|---:|",
    ]
    for status, count in payload["gate_summary"].items():
        lines.append(f"| {status} | {count} |")
    lines.extend(
        [
            "",
            "## Harness Gates",
            "",
            "| layer | target | host | effective_status | harness_status | detail_status | reason |",
            "|---|---|---|---|---|---|---|",
        ]
    )
    for row in payload["gates"]:
        reason = str(row.get("exit_reason") or "").replace("|", "/")
        lines.append(
            f"| {row.get('layer', '')} | {row.get('target', '')} | {row.get('host', '')} | {row.get('effective_status', '')} | {row.get('harness_status', '')} | {row.get('detail_status', '')} | {reason} |"
        )
    lines.extend(
        [
            "",
            "## Inconsistent Statuses",
            "",
            "```json",
            json.dumps(payload["inconsistent_statuses"], indent=2, ensure_ascii=False, sort_keys=True),
            "```",
            "",
            "## Detail Summary",
            "",
            "```json",
            json.dumps(payload["detail_summary"], indent=2, ensure_ascii=False, sort_keys=True),
            "```",
            "",
            "## Run Time Summary",
            "",
            "```json",
            json.dumps(payload["run_time_summary"], indent=2, ensure_ascii=False, sort_keys=True),
            "```",
            "",
            "## Performance Summary",
            "",
            "```json",
            json.dumps(payload["performance_summary"], indent=2, ensure_ascii=False, sort_keys=True),
            "```",
        ]
    )
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo-root", type=Path, default=repo_root())
    parser.add_argument("--output", type=Path, default=repo_root() / "build" / "validation" / "final-summary.json")
    parser.add_argument("--markdown", type=Path, default=repo_root() / "build" / "validation" / "final-summary.md")
    args = parser.parse_args()

    payload = build_summary(args.repo_root.resolve())
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(json.dumps(payload, indent=2, ensure_ascii=False, sort_keys=True) + "\n", encoding="utf-8")
    write_markdown(args.markdown, payload)
    print(f"summary={args.output}")
    print(f"markdown={args.markdown}")
    print(json.dumps(payload["gate_summary"], indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
